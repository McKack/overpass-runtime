+bool
+Atomic64NeedsLock(AtomicRMWInst::BinOp Op, bool CompareExchange, bool ResultUsed, bool Threadgroup) {
+  if (CompareExchange)
+    return true;
+  switch (Op) {
+  case AtomicRMWInst::Add:
+  case AtomicRMWInst::And:
+  case AtomicRMWInst::Or:
+  case AtomicRMWInst::Xor:
+    return false;
+  case AtomicRMWInst::UMin:
+  case AtomicRMWInst::UMax:
+    return Threadgroup || ResultUsed;
+  default:
+    return true;
+  }
+}
+
+bool
+DxilAtomic64NeedsLock(const CallInst &Call) {
+  if (!Call.getType()->isIntegerTy(64))
+    return false;
+  auto Opcode = asU32(Call.getArgOperand(0));
+  if (Opcode == kOpAtomicCmpXchg)
+    return true;
+  if (Opcode != kOpAtomicBinOp)
+    return false;
+  switch (asU32(Call.getArgOperand(2)).value_or(~0u)) {
+  case kAtomicOpAdd:
+    return Atomic64NeedsLock(AtomicRMWInst::Add, false, false, false);
+  case kAtomicOpAnd:
+  case kAtomicOpOr:
+  case kAtomicOpXor:
+    return false;
+  case kAtomicOpUMin:
+  case kAtomicOpUMax:
+    return !Call.use_empty();
+  default:
+    return true;
+  }
+}
+
+// One 32-bit AIR atomic on device (address space 1) or threadgroup (3) memory, relaxed. Op is load, store,
+// cmpxchg.weak or a read-modify-write name; Args go between the pointer and the order/scope operands.
+llvm::Value *
+Converter::AtomicCall32(StringRef Op, Value *Ptr, ArrayRef<Value *> Args, bool Void) {
+  bool Local = Ptr->getType()->getPointerAddressSpace() == 3;
+  bool Exchange = Op == "cmpxchg.weak";
+  std::string Name = std::string("air.atomic.") + (Local ? "local." : "global.") + Op.str();
+  bool Typed = Op != "load" && Op != "store" && !Exchange && Op != "xchg";
+  Name += Typed ? ".u.i32" : ".i32";
+  SmallVector<Type *> Tys{Ptr->getType()};
+  SmallVector<Value *> Ops{Ptr};
+  for (auto *Arg : Args) {
+    Tys.push_back(Arg->getType());
+    Ops.push_back(Arg);
+  }
+  // memory order(s) relaxed, then the scope and volatile
+  Tys.push_back(ir.getInt32Ty());
+  Ops.push_back(ir.getInt32(0));
+  if (Exchange) {
+    Tys.push_back(ir.getInt32Ty());
+    Ops.push_back(ir.getInt32(0));
+  }
+  Tys.push_back(ir.getInt32Ty());
+  Ops.push_back(ir.getInt32(Local ? 1 : 2));
+  Tys.push_back(ir.getInt1Ty());
+  Ops.push_back(ir.getTrue());
+  auto *Fn = air.getModule()
+                 ->getOrInsertFunction(Name, FunctionType::get(Void ? ir.getVoidTy() : ir.getInt32Ty(), Tys, false))
+                 .getCallee();
+  return ir.CreateCall(cast<Function>(Fn)->getFunctionType(), Fn, Ops);
+}
+
+// Threadgroup lock words exist when a groupshared 64-bit atomic needs one; every thread zeroes them before the
+// shader body starts.
+void
+Converter::InitializeLocalAtomic64Locks() {
+  for (auto &BB : *entry.function)
+    for (auto &Inst : BB) {
+      if (auto *RMW = dyn_cast<AtomicRMWInst>(&Inst))
+        local_atomic64_locked_ |= RMW->getValOperand()->getType()->isIntegerTy(64) &&
+                                  Atomic64NeedsLock(RMW->getOperation(), false, !RMW->use_empty(), true);
+      if (auto *CmpXchg = dyn_cast<AtomicCmpXchgInst>(&Inst))
+        local_atomic64_locked_ |= CmpXchg->getNewValOperand()->getType()->isIntegerTy(64);
+    }
+  if (!local_atomic64_locked_)
+    return;
+  auto *Ty = ArrayType::get(ir.getInt32Ty(), 32);
+  local_atomic64_locks_ = new GlobalVariable(
+      *air.getModule(), Ty, false, GlobalValue::InternalLinkage, UndefValue::get(Ty), "atomic64_locks", nullptr,
+      GlobalValue::NotThreadLocal, 3
+  );
+  local_atomic64_locks_->setAlignment(Align(4));
+  ir.SetInsertPoint(block_map_[&entry.function->getEntryBlock()]);
+  ir.CreateStore(ConstantAggregateZero::get(Ty), local_atomic64_locks_);
+  air.CreateBarrier(MemFlags::Threadgroup);
+}
+
+// Ptr is an i64 pointer to device or threadgroup memory. With Compare it's a compare-exchange (Op ignored).
+// Returns the previous value.
+llvm::Expected<llvm::Value *>
+Converter::EmitAtomic64(AtomicRMWInst::BinOp Op, Value *Ptr, Value *Val, Value *Compare, bool ResultUsed) {
+  bool Local = Ptr->getType()->getPointerAddressSpace() == 3;
+  unsigned AS = Local ? 3 : 1;
+  auto *I32 = ir.getInt32Ty(), *I64 = ir.getInt64Ty();
+  auto *Lo = ir.CreateBitCast(Ptr, I32->getPointerTo(AS));
+  auto *Hi = ir.CreateGEP(I32, Lo, {ir.getInt32(1)});
+  auto Combine = [&](Value *L, Value *H) {
+    return ir.CreateOr(ir.CreateZExt(L, I64), ir.CreateShl(ir.CreateZExt(H, I64), 32));
+  };
+
+  // A shader takes the lock for all of its 64-bit atomics in one address space once any of them needs it, so that
+  // they stay atomic with respect to each other.
+  auto *DeviceLocks = Local ? nullptr : ctx.binding.GetAtomic64LockTable(air);
+  bool Locked = Local ? local_atomic64_locked_ : DeviceLocks != nullptr;
+  if (Atomic64NeedsLock(Op, Compare != nullptr, ResultUsed, Local) && !Locked)
+    return unsupported("dxil: 64-bit atomic without a lock table");
+
+  if (!Locked) {
+    if (Op == AtomicRMWInst::UMin || Op == AtomicRMWInst::UMax) {
+      // native: void air.atomic.global.{min,max}.u.i64
+      std::string Name = std::string("air.atomic.global.") + (Op == AtomicRMWInst::UMin ? "min" : "max") + ".u.i64";
+      auto Fn = air.getModule()->getOrInsertFunction(
+          Name, FunctionType::get(ir.getVoidTy(), {Ptr->getType(), I64, I32, I32, ir.getInt1Ty()}, false)
+      );
+      ir.CreateCall(Fn, {Ptr, Val, ir.getInt32(0), ir.getInt32(2), ir.getTrue()});
+      return UndefValue::get(I64);
+    }
+    auto *ValLo = ir.CreateTrunc(Val, I32);
+    auto *ValHi = ir.CreateTrunc(ir.CreateLShr(Val, 32), I32);
+    StringRef Name = Op == AtomicRMWInst::Add ? "add" : Op == AtomicRMWInst::And ? "and" : Op == AtomicRMWInst::Or ? "or" : "xor";
+    auto *OldLo = AtomicCall32(Name, Lo, {ValLo}, false);
+    if (Op == AtomicRMWInst::Add) {
+      auto *Carry = ir.CreateZExt(ir.CreateICmpULT(ir.CreateAdd(OldLo, ValLo), OldLo), I32);
+      ValHi = ir.CreateAdd(ValHi, Carry);
+    }
+    auto *OldHi = AtomicCall32(Name, Hi, {ValHi}, false);
+    return Combine(OldLo, OldHi);
+  }
+
+  // Spin lock. Every lane of the SIMD group stays in the loop until all of them are done (a convergent simd_any
+  // decides), so a lane holding the lock always gets to release it: with a divergent exit, the compiler may move
+  // the critical section after the loop, where its lane waits for the spinning ones forever.
+  auto *Addr = ir.CreateLShr(ir.CreatePtrToInt(Ptr, I64), 3);
+  Value *Lock;
+  if (Local) {
+    auto *Slot = ir.CreateAnd(ir.CreateTrunc(Addr, I32), 31);
+    Lock = ir.CreateGEP(local_atomic64_locks_->getValueType(), local_atomic64_locks_, {ir.getInt32(0), Slot});
+  } else {
+    auto *Slot = ir.CreateAnd(ir.CreateTrunc(Addr, I32), 4095);
+    Lock = ir.CreateGEP(I32, ir.CreateBitCast(DeviceLocks, I32->getPointerTo(1)), {Slot});
+  }
+  auto *Fn = ir.GetInsertBlock()->getParent();
+  auto *EntryBB = &Fn->getEntryBlock();
+  auto *BeforeBB = ir.GetInsertBlock();
+  auto *LoopBB = BasicBlock::Create(air.getContext(), "atomic64.lock", Fn);
+  auto *TryBB = BasicBlock::Create(air.getContext(), "atomic64.try", Fn);
+  auto *CriticalBB = BasicBlock::Create(air.getContext(), "atomic64.critical", Fn);
+  auto *LatchBB = BasicBlock::Create(air.getContext(), "atomic64.latch", Fn);
+  auto *DoneBB = BasicBlock::Create(air.getContext(), "atomic64.done", Fn);
+
+  IRBuilder<> EntryIR(EntryBB, EntryBB->getFirstInsertionPt());
+  auto *Expected = EntryIR.CreateAlloca(I32);
+  ir.CreateBr(LoopBB);
+
+  ir.SetInsertPoint(LoopBB);
+  auto *WasDone = ir.CreatePHI(ir.getInt1Ty(), 2);
+  auto *WasResult = ir.CreatePHI(I64, 2);
+  WasDone->addIncoming(ir.getFalse(), BeforeBB);
+  WasResult->addIncoming(UndefValue::get(I64), BeforeBB);
+  ir.CreateCondBr(WasDone, LatchBB, TryBB);
+
+  ir.SetInsertPoint(TryBB);
+  ir.CreateStore(ir.getInt32(0), Expected);
+  auto *Previous = AtomicCall32("cmpxchg.weak", Lock, {Expected, ir.getInt32(1)}, false);
+  ir.CreateCondBr(ir.CreateICmpEQ(Previous, ir.getInt32(0)), CriticalBB, LatchBB);
+
+  ir.SetInsertPoint(CriticalBB);
+  auto Flags = Local ? MemFlags::Threadgroup : MemFlags::Device;
+  auto Scope = Local ? ThreadScope::Threadgroup : ThreadScope::Device;
+  air.CreateAtomicFence(Flags, Scope, false);
+  auto *Old = Combine(AtomicCall32("load", Lo, {}, false), AtomicCall32("load", Hi, {}, false));
+  Value *New;
+  if (Compare) {
+    New = ir.CreateSelect(ir.CreateICmpEQ(Old, Compare), Val, Old);
+  } else {
+    switch (Op) {
+    case AtomicRMWInst::Add: New = ir.CreateAdd(Old, Val); break;
+    case AtomicRMWInst::Sub: New = ir.CreateSub(Old, Val); break;
+    case AtomicRMWInst::And: New = ir.CreateAnd(Old, Val); break;
+    case AtomicRMWInst::Or: New = ir.CreateOr(Old, Val); break;
+    case AtomicRMWInst::Xor: New = ir.CreateXor(Old, Val); break;
+    case AtomicRMWInst::Max: New = ir.CreateSelect(ir.CreateICmpSGT(Old, Val), Old, Val); break;
+    case AtomicRMWInst::Min: New = ir.CreateSelect(ir.CreateICmpSLT(Old, Val), Old, Val); break;
+    case AtomicRMWInst::UMax: New = ir.CreateSelect(ir.CreateICmpUGT(Old, Val), Old, Val); break;
+    case AtomicRMWInst::UMin: New = ir.CreateSelect(ir.CreateICmpULT(Old, Val), Old, Val); break;
+    case AtomicRMWInst::Xchg: New = Val; break;
+    default: return unsupported("dxil: unsupported 64-bit atomic operation");
+    }
+  }
+  AtomicCall32("store", Lo, {ir.CreateTrunc(New, I32)}, true);
+  AtomicCall32("store", Hi, {ir.CreateTrunc(ir.CreateLShr(New, 32), I32)}, true);
+  air.CreateAtomicFence(Flags, Scope, false);
+  AtomicCall32("store", Lock, {ir.getInt32(0)}, true);
+  ir.CreateBr(LatchBB);
+
+  ir.SetInsertPoint(LatchBB);
+  auto *Done = ir.CreatePHI(ir.getInt1Ty(), 3);
+  Done->addIncoming(ir.getTrue(), CriticalBB);
+  Done->addIncoming(ir.getFalse(), TryBB);
+  Done->addIncoming(ir.getTrue(), LoopBB);
+  auto *Result = ir.CreatePHI(I64, 3);
+  Result->addIncoming(Old, CriticalBB);
+  Result->addIncoming(WasResult, TryBB);
+  Result->addIncoming(WasResult, LoopBB);
+  WasDone->addIncoming(Done, LatchBB);
+  WasResult->addIncoming(Result, LatchBB);
+  auto *AnyLeft = SimdCall("air.simd_any", ir.getInt1Ty(), {ir.CreateNot(Done)});
+  ir.CreateCondBr(AnyLeft, LoopBB, DoneBB);
+
+  ir.SetInsertPoint(DoneBB);
+  return Result;
+}
