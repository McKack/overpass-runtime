+
+/* GPUs */
+
+NVAPI_INTERFACE
+NvAPI_SYS_GetPhysicalGPUs(NV_PHYSICAL_GPUS *pPhysicalGPUs) {
+  if (!pPhysicalGPUs)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pPhysicalGPUs->version != NV_PHYSICAL_GPUS_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+
+  auto devices = WMT::CopyAllDevices();
+  auto count = std::min<unsigned>(devices.count(), NVAPI_MAX_PHYSICAL_GPUS);
+  for (unsigned i = 0; i < count; i++) {
+    pPhysicalGPUs->gpuHandleData[i].hPhysicalGpu = (NvPhysicalGpuHandle)devices.object(i).registryID();
+    pPhysicalGPUs->gpuHandleData[i].adapterType = NV_ADAPTER_TYPE_WDDM;
+  }
+  pPhysicalGPUs->gpuHandleCount = count;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_SYS_GetLogicalGPUs(NV_LOGICAL_GPUS *pLogicalGPUs) {
+  if (!pLogicalGPUs)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pLogicalGPUs->version != NV_LOGICAL_GPUS_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+
+  auto devices = WMT::CopyAllDevices();
+  auto count = std::min<unsigned>(devices.count(), NVAPI_MAX_LOGICAL_GPUS);
+  for (unsigned i = 0; i < count; i++) {
+    pLogicalGPUs->gpuHandleData[i].hLogicalGpu = (NvLogicalGpuHandle)devices.object(i).registryID();
+    pLogicalGPUs->gpuHandleData[i].adapterType = NV_ADAPTER_TYPE_WDDM;
+  }
+  pLogicalGPUs->gpuHandleCount = count;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetLogicalGPUFromPhysicalGPU(NvPhysicalGpuHandle hPhysicalGPU, NvLogicalGpuHandle *pLogicalGPU) {
+  if (!pLogicalGPU)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!FindDevice(uint64_t(hPhysicalGPU)))
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+
+  // One physical GPU per logical GPU, so both use the same handle.
+  *pLogicalGPU = (NvLogicalGpuHandle)hPhysicalGPU;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetPhysicalGPUsFromLogicalGPU(
+    NvLogicalGpuHandle hLogicalGPU, NvPhysicalGpuHandle hPhysicalGPU[NVAPI_MAX_PHYSICAL_GPUS], NvU32 *pGpuCount
+) {
+  if (!hPhysicalGPU || !pGpuCount)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!FindDevice(uint64_t(hLogicalGPU)))
+    return NVAPI_EXPECTED_LOGICAL_GPU_HANDLE;
+
+  hPhysicalGPU[0] = (NvPhysicalGpuHandle)hLogicalGPU;
+  *pGpuCount = 1;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetGPUIDfromPhysicalGPU(NvPhysicalGpuHandle hPhysicalGpu, NvU32 *pGpuId) {
+  if (!pGpuId)
+    return NVAPI_INVALID_ARGUMENT;
+  auto device = FindDevice(uint64_t(hPhysicalGpu));
+  if (!device)
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+
+  *pGpuId = GpuId(device);
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetPhysicalGPUFromGPUID(NvU32 gpuId, NvPhysicalGpuHandle *hPhysicalGpu) {
+  if (!hPhysicalGpu)
+    return NVAPI_INVALID_ARGUMENT;
+
+  auto devices = WMT::CopyAllDevices();
+  for (unsigned i = 0; i < devices.count(); i++) {
+    if (GpuId(devices.object(i)) == gpuId) {
+      *hPhysicalGpu = (NvPhysicalGpuHandle)devices.object(i).registryID();
+      return NVAPI_OK;
+    }
+  }
+  return NVAPI_INVALID_ARGUMENT;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetGPUType(NvPhysicalGpuHandle hPhysicalGpu, NV_GPU_TYPE *pGpuType) {
+  if (!pGpuType)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!FindDevice(uint64_t(hPhysicalGpu)))
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+
+  // DXMT presents the GPU as a GeForce RTX 4090 (see NvAPI_GPU_GetFullName), a discrete GPU.
+  *pGpuType = NV_SYSTEM_TYPE_DGPU;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetGPUInfo(NvPhysicalGpuHandle hPhysicalGpu, NV_GPU_INFO *pGpuInfo) {
+  if (!pGpuInfo)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!FindDevice(uint64_t(hPhysicalGpu)))
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+
+  switch (pGpuInfo->version) {
+  case NV_GPU_INFO_VER1: {
+    auto pGpuInfoV1 = reinterpret_cast<NV_GPU_INFO_V1 *>(pGpuInfo);
+    *pGpuInfoV1 = {};
+    pGpuInfoV1->version = NV_GPU_INFO_VER1;
+    break;
+  }
+  case NV_GPU_INFO_VER2:
+    *pGpuInfo = {};
+    pGpuInfo->version = NV_GPU_INFO_VER2;
+    // GeForce RTX 4090, matching NvAPI_GPU_GetArchInfo (AD102).
+    pGpuInfo->rayTracingCores = 128;
+    pGpuInfo->tensorCores = 512;
+    break;
+  default:
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  }
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetPCIIdentifiers(
+    NvPhysicalGpuHandle hPhysicalGpu, NvU32 *pDeviceId, NvU32 *pSubSystemId, NvU32 *pRevisionId, NvU32 *pExtDeviceId
+) {
+  if (!pDeviceId || !pSubSystemId || !pRevisionId || !pExtDeviceId)
+    return NVAPI_INVALID_ARGUMENT;
+  auto device = FindDevice(uint64_t(hPhysicalGpu));
+  if (!device)
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+
+  // Report what DXGI reports for this adapter, so dxgi.customDeviceId and friends apply here too.
+  auto luid = GetAdapterLuid(device);
+  Com<IDXGIFactory1> factory;
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory))))
+    return NVAPI_ERROR;
+  Com<IDXGIAdapter1> adapter;
+  for (UINT i = 0; SUCCEEDED(factory->EnumAdapters1(i, &adapter)); i++) {
+    DXGI_ADAPTER_DESC1 desc;
+    if (SUCCEEDED(adapter->GetDesc1(&desc)) && desc.AdapterLuid.LowPart == luid.LowPart &&
+        desc.AdapterLuid.HighPart == luid.HighPart) {
+      *pDeviceId = (desc.DeviceId << 16) | desc.VendorId;
+      *pSubSystemId = desc.SubSysId;
+      *pRevisionId = desc.Revision;
+      *pExtDeviceId = desc.DeviceId;
+      return NVAPI_OK;
+    }
+    adapter = nullptr;
+  }
+  return NVAPI_NVIDIA_DEVICE_NOT_FOUND;
+}
+
+NVAPI_INTERFACE
+NvAPI_GPU_GetThermalSettings(NvPhysicalGpuHandle hPhysicalGpu, NvU32 sensorIndex, NV_GPU_THERMAL_SETTINGS *pThermalSettings) {
+  if (!pThermalSettings)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pThermalSettings->version != NV_GPU_THERMAL_SETTINGS_VER_1 &&
+      pThermalSettings->version != NV_GPU_THERMAL_SETTINGS_VER_2)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  if (!FindDevice(uint64_t(hPhysicalGpu)))
+    return NVAPI_EXPECTED_PHYSICAL_GPU_HANDLE;
+
+  // No temperature source; dxvk-nvapi answers the same way without NVML.
+  return NVAPI_NO_IMPLEMENTATION;
+}
+
+/* Displays. Display handles are HMONITORs (see NvAPI_EnumNvidiaDisplayHandle); every GPU drives every display
+   (see NvAPI_GetPhysicalGPUsFromDisplay). */
+
+NVAPI_INTERFACE
+NvAPI_GetAssociatedNvidiaDisplayHandle(const char *szDisplayName, NvDisplayHandle *pNvDispHandle) {
+  if (!szDisplayName || !pNvDispHandle)
+    return NVAPI_INVALID_ARGUMENT;
+
+  struct Search {
+    std::string name;
+    HMONITOR found;
+  } search{szDisplayName, nullptr};
+  ::EnumDisplayMonitors(
+      nullptr, nullptr,
+      [](HMONITOR hmon, HDC hdc, LPRECT rect, LPARAM lp) -> BOOL {
+        auto search = reinterpret_cast<Search *>(lp);
+        MONITORINFOEXW info;
+        info.cbSize = sizeof(info);
+        if (!::GetMonitorInfoW(hmon, reinterpret_cast<MONITORINFO *>(&info)))
+          return TRUE;
+        if (search->name != str::fromws(info.szDevice))
+          return TRUE;
+        search->found = hmon;
+        return FALSE;
+      },
+      reinterpret_cast<LPARAM>(&search)
+  );
+
+  if (!search.found)
+    return NVAPI_NVIDIA_DEVICE_NOT_FOUND;
+  *pNvDispHandle = (NvDisplayHandle)search.found;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetAssociatedNvidiaDisplayName(NvDisplayHandle NvDispHandle, NvAPI_ShortString szDisplayName) {
+  if (!szDisplayName)
+    return NVAPI_INVALID_ARGUMENT;
+
+  MONITORINFOEXW info;
+  info.cbSize = sizeof(info);
+  if (!NvDispHandle || !::GetMonitorInfoW((HMONITOR)NvDispHandle, reinterpret_cast<MONITORINFO *>(&info)))
+    return NVAPI_EXPECTED_DISPLAY_HANDLE;
+
+  auto name = str::fromws(info.szDevice);
+  auto length = std::min<size_t>(name.size(), NVAPI_SHORT_STRING_MAX - 1);
+  memcpy(szDisplayName, name.c_str(), length);
+  szDisplayName[length] = '\0';
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_GetLogicalGPUFromDisplay(NvDisplayHandle hNvDisp, NvLogicalGpuHandle *pLogicalGPU) {
+  if (!pLogicalGPU)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!IsMonitor(hNvDisp))
+    return NVAPI_EXPECTED_DISPLAY_HANDLE;
+  auto device = FirstDevice();
+  if (!device)
+    return NVAPI_NVIDIA_DEVICE_NOT_FOUND;
+
+  *pLogicalGPU = (NvLogicalGpuHandle)device.registryID();
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_SYS_GetPhysicalGpuFromDisplayId(NvU32 displayId, NvPhysicalGpuHandle *hPhysicalGpu) {
+  if (!hPhysicalGpu)
+    return NVAPI_INVALID_ARGUMENT;
+  if (!IsDisplayId(displayId))
+    return NVAPI_INVALID_ARGUMENT;
+  auto device = FirstDevice();
+  if (!device)
+    return NVAPI_NVIDIA_DEVICE_NOT_FOUND;
+
+  *hPhysicalGpu = (NvPhysicalGpuHandle)device.registryID();
+  return NVAPI_OK;
+}
