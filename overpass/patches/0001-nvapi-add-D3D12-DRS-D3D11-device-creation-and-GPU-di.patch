+NVAPI_INTERFACE
+NvAPI_D3D_RegisterDevice(IUnknown *pDev) {
+  // Nothing to register; acknowledge like the driver does.
+  return NVAPI_OK;
+}
+
+/* D3D12. DXMT has no NVIDIA shader extensions, no raytracing and no opacity micromaps, so these report
+   exactly that instead of being missing. */
+
+NVAPI_INTERFACE
+NvAPI_D3D12_IsNvShaderExtnOpCodeSupported(ID3D12Device *pDevice, NvU32 opCode, bool *pSupported) {
+  if (!pDevice || !pSupported)
+    return NVAPI_INVALID_ARGUMENT;
+
+  *pSupported = false;
+  return NVAPI_OK;
+}
+
+static NvAPI_Status
+SetNvShaderExtnSlotSpace(IUnknown *pDev) {
+  if (!pDev)
+    return NVAPI_INVALID_ARGUMENT;
+
+  Com<ID3D12Device> device;
+  if (FAILED(pDev->QueryInterface(IID_PPV_ARGS(&device))))
+    return NVAPI_INVALID_ARGUMENT;
+
+  return NVAPI_NO_IMPLEMENTATION;
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_SetNvShaderExtnSlotSpace(IUnknown *pDev, NvU32 uavSlot, NvU32 uavSpace) {
+  return SetNvShaderExtnSlotSpace(pDev);
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_SetNvShaderExtnSlotSpaceLocalThread(IUnknown *pDev, NvU32 uavSlot, NvU32 uavSpace) {
+  return SetNvShaderExtnSlotSpace(pDev);
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_GetRaytracingCaps(ID3D12Device *pDevice, NVAPI_D3D12_RAYTRACING_CAPS_TYPE type, void *pData, size_t dataSize) {
+  if (!pDevice || !pData)
+    return NVAPI_INVALID_POINTER;
+
+  switch (type) {
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_THREAD_REORDERING:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_THREAD_REORDERING_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_THREAD_REORDERING_CAPS *>(pData) =
+        NVAPI_D3D12_RAYTRACING_THREAD_REORDERING_CAP_NONE;
+    break;
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_OPACITY_MICROMAP:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_OPACITY_MICROMAP_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_OPACITY_MICROMAP_CAPS *>(pData) =
+        NVAPI_D3D12_RAYTRACING_OPACITY_MICROMAP_CAP_NONE;
+    break;
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_DISPLACEMENT_MICROMAP:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_DISPLACEMENT_MICROMAP_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_DISPLACEMENT_MICROMAP_CAPS *>(pData) =
+        NVAPI_D3D12_RAYTRACING_DISPLACEMENT_MICROMAP_CAP_NONE;
+    break;
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_CLUSTER_OPERATIONS:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_CLUSTER_OPERATIONS_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_CLUSTER_OPERATIONS_CAPS *>(pData) =
+        NVAPI_D3D12_RAYTRACING_CLUSTER_OPERATIONS_CAP_NONE;
+    break;
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_PARTITIONED_TLAS:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_PARTITIONED_TLAS_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_PARTITIONED_TLAS_CAPS *>(pData) =
+        NVAPI_D3D12_RAYTRACING_PARTITIONED_TLAS_CAP_NONE;
+    break;
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_SPHERES:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_SPHERES_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_SPHERES_CAPS *>(pData) = NVAPI_D3D12_RAYTRACING_SPHERES_CAP_NONE;
+    break;
+  case NVAPI_D3D12_RAYTRACING_CAPS_TYPE_LINEAR_SWEPT_SPHERES:
+    if (dataSize != sizeof(NVAPI_D3D12_RAYTRACING_LINEAR_SWEPT_SPHERES_CAPS))
+      return NVAPI_INVALID_ARGUMENT;
+    *static_cast<NVAPI_D3D12_RAYTRACING_LINEAR_SWEPT_SPHERES_CAPS *>(pData) =
+        NVAPI_D3D12_RAYTRACING_LINEAR_SWEPT_SPHERES_CAP_NONE;
+    break;
+  default:
+    return NVAPI_INVALID_ARGUMENT;
+  }
+
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_GetRaytracingAccelerationStructurePrebuildInfoEx(
+    ID3D12Device5 *pDevice, NVAPI_GET_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO_EX_PARAMS *pParams
+) {
+  if (!pDevice || !pParams)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pParams->version != NVAPI_GET_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO_EX_PARAMS_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  if (!pParams->pDesc || !pParams->pInfo)
+    return NVAPI_INVALID_ARGUMENT;
+
+  // No DXR in DXMT: the device does not implement ID3D12Device5.
+  return NVAPI_NO_IMPLEMENTATION;
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_BuildRaytracingAccelerationStructureEx(
+    ID3D12GraphicsCommandList4 *pCommandList, const NVAPI_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_EX_PARAMS *pParams
+) {
+  if (!pCommandList || !pParams)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pParams->version != NVAPI_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_EX_PARAMS_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  if (!pParams->pDesc)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pParams->numPostbuildInfoDescs && !pParams->pPostbuildInfoDescs)
+    return NVAPI_INVALID_ARGUMENT;
+
+  // No DXR in DXMT: command lists do not implement ID3D12GraphicsCommandList4.
+  return NVAPI_NO_IMPLEMENTATION;
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_SetCreatePipelineStateOptions(
+    ID3D12Device5 *pDevice, const NVAPI_D3D12_SET_CREATE_PIPELINE_STATE_OPTIONS_PARAMS *pState
+) {
+  if (!pDevice || !pState)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pState->version != NVAPI_D3D12_SET_CREATE_PIPELINE_STATE_OPTIONS_PARAMS_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+
+  // The only option is opacity micromap support, which needs raytracing.
+  return NVAPI_NOT_SUPPORTED;
+}
+
+// Reflex on D3D12 is accepted and ignored, like DXMT's NvAPI_D3D_SetSleepMode and NvAPI_D3D_SetLatencyMarker.
+NVAPI_INTERFACE
+NvAPI_D3D12_NotifyOutOfBandCommandQueue(ID3D12CommandQueue *pCommandQueue, NV_OUT_OF_BAND_CQ_TYPE cqType) {
+  if (!pCommandQueue)
+    return NVAPI_INVALID_POINTER;
+
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_D3D12_SetAsyncFrameMarker(ID3D12CommandQueue *pCommandQueue, NV_ASYNC_FRAME_MARKER_PARAMS *pSetAsyncFrameMarkerParams) {
+  if (!pCommandQueue || !pSetAsyncFrameMarkerParams)
+    return NVAPI_INVALID_POINTER;
+  if (pSetAsyncFrameMarkerParams->version != NV_ASYNC_FRAME_MARKER_PARAMS_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+
+  return NVAPI_OK;
+}
+
+/* DRS. One fixed session and profile; nothing is stored, every setting reads as not found. */
+
+static auto s_drs = 1U;
+static auto s_drs_session = reinterpret_cast<NvDRSSessionHandle>(&s_drs);
+static auto s_drs_profile = reinterpret_cast<NvDRSProfileHandle>(&s_drs);
+
+NVAPI_INTERFACE
+NvAPI_DRS_CreateSession(NvDRSSessionHandle *phSession) {
+  if (!phSession)
+    return NVAPI_INVALID_ARGUMENT;
+
+  *phSession = s_drs_session;
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_DestroySession(NvDRSSessionHandle hSession) {
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_LoadSettings(NvDRSSessionHandle hSession) {
+  return NVAPI_OK;
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_SaveSettings(NvDRSSessionHandle hSession) {
+  return NVAPI_NOT_SUPPORTED;
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_SetSetting(NvDRSSessionHandle hSession, NvDRSProfileHandle hProfile, NVDRS_SETTING *pSetting) {
+  return NVAPI_NOT_SUPPORTED;
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_GetSetting(NvDRSSessionHandle hSession, NvDRSProfileHandle hProfile, NvU32 settingId, NVDRS_SETTING *pSetting) {
+  if (!pSetting)
+    return NVAPI_INVALID_ARGUMENT;
+  if (pSetting->version != NVDRS_SETTING_VER1)
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+
+  return NVAPI_SETTING_NOT_FOUND;
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_FindProfileByName(NvDRSSessionHandle hSession, NvAPI_UnicodeString profileName, NvDRSProfileHandle *phProfile) {
+  if (!phProfile)
+    return NVAPI_INVALID_ARGUMENT;
+
+  *phProfile = s_drs_profile;
+  return NVAPI_OK;
+}
+
+static void
+CopyUnicodeString(NvAPI_UnicodeString dst, const NvAPI_UnicodeString src) {
+  if (!src)
+    return;
+  for (size_t i = 0; i < NVAPI_UNICODE_STRING_MAX - 1 && src[i]; i++)
+    dst[i] = src[i];
+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_FindApplicationByName(
+    NvDRSSessionHandle hSession, NvAPI_UnicodeString appName, NvDRSProfileHandle *phProfile,
+    NVDRS_APPLICATION *pApplication
+) {
+  if (!phProfile || !pApplication)
+    return NVAPI_INVALID_ARGUMENT;
+
+  switch (pApplication->version) {
+  case NVDRS_APPLICATION_VER_V4:
+    memset(pApplication->commandLine, 0, sizeof(pApplication->commandLine));
+    [[fallthrough]];
+  case NVDRS_APPLICATION_VER_V3:
+    pApplication->isCommandLine = 0;
+    pApplication->isMetro = 0;
+    [[fallthrough]];
+  case NVDRS_APPLICATION_VER_V2:
+    memset(pApplication->fileInFolder, 0, sizeof(pApplication->fileInFolder));
+    [[fallthrough]];
+  case NVDRS_APPLICATION_VER_V1:
+    memset(pApplication->launcher, 0, sizeof(pApplication->launcher));
+    memset(pApplication->userFriendlyName, 0, sizeof(pApplication->userFriendlyName));
+    memset(pApplication->appName, 0, sizeof(pApplication->appName));
+    CopyUnicodeString(pApplication->userFriendlyName, appName);
+    CopyUnicodeString(pApplication->appName, appName);
+    pApplication->isPredefined = 0;
+    break;
+  default:
+    return NVAPI_INCOMPATIBLE_STRUCT_VERSION;
+  }
+
+  *phProfile = s_drs_profile;
+  return NVAPI_OK;
+}
+
