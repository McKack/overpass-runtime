+}
+
+NVAPI_INTERFACE
+NvAPI_DRS_DeleteProfile(NvDRSSessionHandle hSession, NvDRSProfileHandle hProfile) {
+  return NVAPI_NOT_SUPPORTED;
+}
+
+NVAPI_INTERFACE
