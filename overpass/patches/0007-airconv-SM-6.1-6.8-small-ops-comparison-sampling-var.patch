+// Packed integer math (SM 6.4 / 6.6): dot products of four 8-bit lanes or two halves, 8-bit pack/unpack.
+llvm::Expected<llvm::Value *>
+Converter::EmitPackedMath(const CallInst &Call) {
+  auto Opcode = asU32(Call.getArgOperand(0));
+  if (!Opcode)
+    return unsupported("dxil: non-constant opcode");
+  auto *I32 = ir.getInt32Ty();
+  auto Byte = [&](Value *Packed, unsigned i, bool Signed) -> Value * {
+    auto *B = ir.CreateTrunc(ir.CreateLShr(Packed, i * 8), ir.getInt8Ty());
+    return Signed ? ir.CreateSExt(B, I32) : ir.CreateZExt(B, I32);
+  };
+  switch (*Opcode) {
+  case kOpDot4AddI8Packed:
+  case kOpDot4AddU8Packed: {
+    auto Acc = Get(Call.getArgOperand(1)), A = Get(Call.getArgOperand(2)), B = Get(Call.getArgOperand(3));
+    if (!Acc) return Acc.takeError();
+    if (!A) return A.takeError();
+    if (!B) return B.takeError();
+    bool Signed = *Opcode == kOpDot4AddI8Packed;
+    Value *Sum = *Acc;
+    for (unsigned i = 0; i < 4; i++)
+      Sum = ir.CreateAdd(Sum, ir.CreateMul(Byte(*A, i, Signed), Byte(*B, i, Signed)));
+    return Sum;
+  }
+  case kOpDot2AddHalf: {
+    Value *V[5];
+    for (unsigned i = 0; i < 5; i++) {
+      auto X = Get(Call.getArgOperand(1 + i));
+      if (!X) return X.takeError();
+      V[i] = *X;
+    }
+    auto *F = ir.getFloatTy();
+    auto Ext = [&](Value *H) { return ir.CreateFPExt(H, F); };
+    return ir.CreateFAdd(V[0], ir.CreateFAdd(ir.CreateFMul(Ext(V[1]), Ext(V[3])), ir.CreateFMul(Ext(V[2]), Ext(V[4]))));
+  }
+  case kOpUnpack4x8: {
+    auto Mode = asU32(Call.getArgOperand(1));
+    auto Packed = Get(Call.getArgOperand(2));
+    if (!Packed) return Packed.takeError();
+    bool Signed = Mode && *Mode == 1;
+    auto *TyResult = MapType(Call.getType());
+    auto *TyElement = TyResult->getStructElementType(0);
+    Value *Result = PoisonValue::get(TyResult);
+    for (unsigned i = 0; i < 4; i++) {
+      auto *B = ir.CreateTrunc(ir.CreateLShr(*Packed, i * 8), ir.getInt8Ty());
+      Result = ir.CreateInsertValue(Result, Signed ? ir.CreateSExt(B, TyElement) : ir.CreateZExt(B, TyElement), i);
+    }
+    return Result;
+  }
+  case kOpPack4x8: {
+    auto Mode = asU32(Call.getArgOperand(1));
+    if (!Mode) return unsupported("dxil: non-constant pack mode");
+    Value *Packed = ir.getInt32(0);
+    for (unsigned i = 0; i < 4; i++) {
+      auto X = Get(Call.getArgOperand(2 + i));
+      if (!X) return X.takeError();
+      Value *V = ir.CreateSExtOrTrunc(*X, I32);
+      if (*Mode == 1) { // clamp to [0, 255]
+        V = ir.CreateSelect(ir.CreateICmpSLT(V, ir.getInt32(0)), ir.getInt32(0), V);
+        V = ir.CreateSelect(ir.CreateICmpSGT(V, ir.getInt32(255)), ir.getInt32(255), V);
+      } else if (*Mode == 2) { // clamp to [-128, 127]
+        V = ir.CreateSelect(ir.CreateICmpSLT(V, ir.getInt32(-128)), ir.getInt32(-128), V);
+        V = ir.CreateSelect(ir.CreateICmpSGT(V, ir.getInt32(127)), ir.getInt32(127), V);
+      }
+      Packed = ir.CreateOr(Packed, ir.CreateShl(ir.CreateAnd(V, ir.getInt32(0xff)), i * 8));
+    }
+    return Packed;
+  }
+  default:
+    return unsupported("dxil: unsupported packed math opcode");
+  }
+}
