+  uint32_t HeapQwordOffset = ~0u;
 
   size_t NumStaticSamplers;
   uint64_t const *EncodedStaticSamplers;
diff --git a/src/d3d12/d3d12_root_signature.cpp b/src/d3d12/d3d12_root_signature.cpp
index 7a24aac..79ed182 100644
--- a/src/d3d12/d3d12_root_signature.cpp
