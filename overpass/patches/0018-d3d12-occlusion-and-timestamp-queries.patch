+  SampleTimestamp,
 };
 
 struct EncoderData {
@@ -103,10 +104,20 @@ struct RenderEncoderData : EncoderData {
   uint8_t dsv_readonly_flags;
   uint8_t render_target_count;
   bool use_visibility_result = 0;
+  obj_handle_t visibility_buffer = 0;
   bool use_tessellation = 0;
   bool use_geometry = 0;
 };
 
+// A D3D12 timestamp query: an otherwise empty blit pass whose end is sampled into the query heap's counter buffer
+// (Metal samples only at pass boundaries; the pass needs one command, a fill of `dummy_buffer`).
+struct SampleTimestampEncoderData : EncoderData {
+  obj_handle_t sample_buffer;
+  uint32_t sample_index;
+  obj_handle_t dummy_buffer;
+  uint64_t dummy_offset;
+};
+
 struct BlitEncoderData : EncoderData {
   wmtcmd_blit_nop cmd_head;
   wmtcmd_base *cmd_tail;
