+// D3D12 query results: each entry sums a range of 64-bit values (visibility results, or one stored count) into
+// dst[dst_index], as a 0/1 flag for binary occlusion queries.
+struct DXMTQuerySum {
+  uint dst_index;
+  uint begin;
+  uint end;
+  uint binary;
+};
+
+[[kernel]] void cs_sum_query_results(
+  uint id [[thread_position_in_grid]],
+  constant uint &count [[buffer(0)]],
+  device const DXMTQuerySum *sums [[buffer(1)]],
+  device const ulong *src [[buffer(2)]],
+  device ulong *dst [[buffer(3)]]
+) {
+  if (id >= count)
+    return;
+  DXMTQuerySum sum = sums[id];
+  ulong total = 0;
+  for (uint i = sum.begin; i < sum.end; i++)
+    total += src[i];
+  dst[sum.dst_index] = sum.binary ? ulong(total != 0) : total;
+}
