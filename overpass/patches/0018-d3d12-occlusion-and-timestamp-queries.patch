+  /* occlusion queries */
+
+  // Draws are counted into visibility result slots; a new slot starts whenever the set of running queries changes
+  // or a new render pass starts, so a query's count is the sum of the slots allocated between its begin and end.
+  struct RunningOcclusionQuery {
+    MTLD3D12QueryHeap *heap;
+    UINT index;
+    uint32_t first_slot;
+  };
+  std::vector<RunningOcclusionQuery> running_occlusion_queries_;
+  struct QuerySum {
+    uint32_t dst_index;
+    uint32_t begin;
+    uint32_t end;
+    uint32_t binary;
+  };
+  struct EndedOcclusionQuery {
+    obj_handle_t results;
+    QuerySum sum;
+  };
+  // Ended queries whose sums are written to their heaps in one compute pass (before a resolve, or at Close).
+  std::vector<EndedOcclusionQuery> ended_occlusion_queries_;
+  bool visibility_dirty_ = false;
+  bool visibility_counting_ = false;
+
   UINT num_rtvs;
   D3D12_CPU_DESCRIPTOR_HANDLE rtvs[8];
   D3D12_CPU_DESCRIPTOR_HANDLE dsv;
@@ -507,6 +532,11 @@ public:
 
     ResetState(pInitialPipelineState);
 
+    running_occlusion_queries_.clear();
+    ended_occlusion_queries_.clear();
+    visibility_dirty_ = false;
+    visibility_counting_ = false;
+
     encoder_count = std::numeric_limits<size_t>::max();
     return allocator_->StartRecord(&entry);
   }
@@ -549,6 +579,7 @@ public:
   Close() {
     if (encoder_count < std::numeric_limits<size_t>::max())
       return E_FAIL;
+    WriteOcclusionQueryResults();
     return allocator_->EndRecord(&encoder_count);
   };
 
@@ -668,11 +699,17 @@ public:
       dirty_state_.set(DirtyState::BlendFactor, DirtyState::StencilRef);
       dirty_state_.set(DirtyState::Topology);
       dirty_state_.set(DirtyState::GraphicsPipelineState);
+
+      visibility_counting_ = false;
+      visibility_dirty_ = !running_occlusion_queries_.empty();
     }
 
     if (!pso_graphics_)
       return DrawCallStatus::Invalid;
 
+    if (visibility_dirty_)
+      EncodeVisibilityResultMode();
+
     if (pso_graphics_->is_geometry && dirty_state_.test(DirtyState::Topology)) {
       dirty_state_.set(DirtyState::GraphicsPipelineState);
       dirty_state_.clr(DirtyState::Topology);
@@ -1946,14 +1983,148 @@ public:
     // do nothing for now
   };
 
+  void
+  EncodeVisibilityResultMode() {
+    visibility_dirty_ = false;
+    auto render = static_cast<RenderEncoderData *>(allocator_->encoder_current);
+    uint32_t slot = 0;
+    if (running_occlusion_queries_.empty() || !allocator_->AllocateVisibilitySlot(slot)) {
+      if (!visibility_counting_)
+        return;
+      auto &cmd = allocator_->EncodeRenderCommand<wmtcmd_render_setvisibilitymode>();
+      cmd.type = WMTRenderCommandSetVisibilityMode;
+      cmd.mode = WMTVisibilityResultModeDisabled;
+      cmd.offset = 0;
+      visibility_counting_ = false;
+      return;
+    }
+    render->use_visibility_result = true;
+    render->visibility_buffer = allocator_->visibility_buffer_;
+    auto &cmd = allocator_->EncodeRenderCommand<wmtcmd_render_setvisibilitymode>();
+    cmd.type = WMTRenderCommandSetVisibilityMode;
+    cmd.mode = WMTVisibilityResultModeCounting;
+    cmd.offset = slot * sizeof(uint64_t);
+    visibility_counting_ = true;
+  }
+
+  // One compute pass that writes sums of 64-bit values from `Src` into `Dst` (see cs_sum_query_results).
+  void
+  EncodeQuerySums(const QuerySum *Sums, uint32_t Count, obj_handle_t Src, obj_handle_t Dst, uint64_t DstOffset) {
+    auto pso = device_->GetQueryResultPipeline();
+    if (!pso || !Count)
+      return;
+    allocator_->InvalidateCurrentPass();
+    auto compute = allocator_->AllocatePass<ComputeEncoderData>();
+    compute->type = EncoderType::Compute;
+    compute->cmd_head.type = WMTComputeCommandNop;
+    compute->cmd_head.next.set(0);
+    compute->cmd_tail = (wmtcmd_base *)&compute->cmd_head;
+
+    auto &setpso = allocator_->EncodeComputeCommand<wmtcmd_compute_setpso>();
+    setpso.type = WMTComputeCommandSetPSO;
+    setpso.pso = pso;
+    setpso.threadgroup_size = {64, 1, 1};
+
+    auto count = allocator_->AllocateCommandData<uint32_t>(1);
+    *count = Count;
+    auto &set_count = allocator_->EncodeComputeCommand<wmtcmd_compute_setbytes>();
+    set_count.type = WMTComputeCommandSetBytes;
+    set_count.bytes.set(count);
+    set_count.length = sizeof(uint32_t);
+    set_count.index = 0;
+
+    auto [sums, sums_offset] = allocator_->AllocateGPUHeap(sizeof(QuerySum) * Count, 16);
+    memcpy(sums, Sums, sizeof(QuerySum) * Count);
+    auto &set_sums = allocator_->EncodeComputeCommand<wmtcmd_compute_setbuffer>();
+    set_sums.type = WMTComputeCommandSetBuffer;
+    set_sums.buffer = allocator_->gpu_heap_buffer_;
+    set_sums.offset = sums_offset;
+    set_sums.index = 1;
+
+    auto &set_src = allocator_->EncodeComputeCommand<wmtcmd_compute_setbuffer>();
+    set_src.type = WMTComputeCommandSetBuffer;
+    set_src.buffer = Src;
+    set_src.offset = 0;
+    set_src.index = 2;
+
+    auto &set_dst = allocator_->EncodeComputeCommand<wmtcmd_compute_setbuffer>();
+    set_dst.type = WMTComputeCommandSetBuffer;
+    set_dst.buffer = Dst;
+    set_dst.offset = DstOffset;
+    set_dst.index = 3;
+
+    auto &dispatch = allocator_->EncodeComputeCommand<wmtcmd_compute_dispatch>();
+    dispatch.type = WMTComputeCommandDispatchThreads;
+    dispatch.size = {Count, 1, 1};
+
+    allocator_->InvalidateCurrentPass();
+  }
+
+  // Writes the sums of ended occlusion queries to their heaps, one compute pass per run of queries on the same heap.
+  void
+  WriteOcclusionQueryResults() {
+    if (ended_occlusion_queries_.empty())
+      return;
+    std::vector<QuerySum> sums;
+    for (size_t i = 0; i < ended_occlusion_queries_.size();) {
+      auto results = ended_occlusion_queries_[i].results;
+      sums.clear();
+      for (; i < ended_occlusion_queries_.size() && ended_occlusion_queries_[i].results == results; i++)
+        sums.push_back(ended_occlusion_queries_[i].sum);
+      EncodeQuerySums(sums.data(), sums.size(), allocator_->visibility_buffer_, results, 0);
+    }
+    ended_occlusion_queries_.clear();
+  }
+
   void STDMETHODCALLTYPE
   BeginQuery(ID3D12QueryHeap *pHeap, D3D12_QUERY_TYPE Type, UINT Index) {
-    DEBUG("BeginQuery");
+    auto heap = static_cast<MTLD3D12QueryHeap *>(pHeap);
+    if (!heap || Index >= heap->Count)
+      return;
+    if ((Type == D3D12_QUERY_TYPE_OCCLUSION || Type == D3D12_QUERY_TYPE_BINARY_OCCLUSION) && heap->Results) {
+      running_occlusion_queries_.push_back({heap, Index, allocator_->visibility_slot_count_});
+      visibility_dirty_ = true;
+    }
   };
 
   void STDMETHODCALLTYPE
   EndQuery(ID3D12QueryHeap *pHeap, D3D12_QUERY_TYPE Type, UINT Index) {
-    DEBUG("EndQuery");
+    auto heap = static_cast<MTLD3D12QueryHeap *>(pHeap);
+    if (!heap || Index >= heap->Count)
+      return;
+    switch (Type) {
+    case D3D12_QUERY_TYPE_OCCLUSION:
+    case D3D12_QUERY_TYPE_BINARY_OCCLUSION: {
+      for (auto it = running_occlusion_queries_.begin(); it != running_occlusion_queries_.end(); ++it) {
+        if (it->heap != heap || it->index != Index)
+          continue;
+        // Binary results are made 0/1 when resolved, so both types store the count.
+        ended_occlusion_queries_.push_back(
+            {heap->Results, {Index, it->first_slot, allocator_->visibility_slot_count_, 0}}
+        );
+        running_occlusion_queries_.erase(it);
+        visibility_dirty_ = true;
+        break;
+      }
+      break;
+    }
+    case D3D12_QUERY_TYPE_TIMESTAMP: {
+      if (!heap->Timestamps)
+        break;
+      allocator_->InvalidateCurrentPass();
+      auto pass = allocator_->AllocatePass<SampleTimestampEncoderData>();
+      pass->type = EncoderType::SampleTimestamp;
+      pass->sample_buffer = heap->Timestamps;
+      pass->sample_index = Index;
+      auto [dummy, dummy_offset] = allocator_->AllocateGPUHeap(4, 4);
+      pass->dummy_buffer = allocator_->gpu_heap_buffer_;
+      pass->dummy_offset = dummy_offset;
+      allocator_->InvalidateCurrentPass();
+      break;
+    }
+    default:
+      break;
+    }
   };
 
   void STDMETHODCALLTYPE
@@ -1961,10 +2132,48 @@ public:
       ID3D12QueryHeap *pHeap, D3D12_QUERY_TYPE Type, UINT StartIndex, UINT QueryCount, ID3D12Resource *pDstBuffer,
       UINT64 AlignedDstBufferOffset
   ) {
-    // Queries don't record anything yet. Until they do, results say "visible" and "no time passed" rather than
-    // leaving the buffer as it was: Unreal Engine culls everything its occlusion queries report as 0 samples.
-    if (!pDstBuffer || !QueryCount || !PreBlit())
+    auto heap = static_cast<MTLD3D12QueryHeap *>(pHeap);
+    if (!heap || !pDstBuffer || !QueryCount || StartIndex + QueryCount > heap->Count)
+      return;
+    obj_handle_t dst = static_cast<MTLD3D12Resource *>(pDstBuffer)->buffer->current()->buffer();
+
+    if ((Type == D3D12_QUERY_TYPE_OCCLUSION || Type == D3D12_QUERY_TYPE_BINARY_OCCLUSION) && heap->Results) {
+      WriteOcclusionQueryResults();
+      if (Type == D3D12_QUERY_TYPE_BINARY_OCCLUSION) {
+        std::vector<QuerySum> sums(QueryCount);
+        for (UINT i = 0; i < QueryCount; i++)
+          sums[i] = {i, StartIndex + i, StartIndex + i + 1, 1};
+        EncodeQuerySums(sums.data(), QueryCount, heap->Results, dst, AlignedDstBufferOffset);
+        return;
+      }
+      if (!PreBlit())
+        return;
+      auto &cmd_cp = allocator_->EncodeBlitCommand<wmtcmd_blit_copy_from_buffer_to_buffer>();
+      cmd_cp.type = WMTBlitCommandCopyFromBufferToBuffer;
+      cmd_cp.src = heap->Results;
+      cmd_cp.dst = dst;
+      cmd_cp.src_offset = sizeof(uint64_t) * StartIndex;
+      cmd_cp.dst_offset = AlignedDstBufferOffset;
+      cmd_cp.copy_length = sizeof(uint64_t) * QueryCount;
       return;
+    }
+
+    if (!PreBlit())
+      return;
+
+    if (Type == D3D12_QUERY_TYPE_TIMESTAMP && heap->Timestamps) {
+      auto &cmd = allocator_->EncodeBlitCommand<wmtcmd_blit_resolvecounters>();
+      cmd.type = WMTBlitCommandResolveCounters;
+      cmd.sample_buffer = heap->Timestamps;
+      cmd.start = StartIndex;
+      cmd.len = QueryCount;
+      cmd.dst_buffer = dst;
+      cmd.dst_offset = AlignedDstBufferOffset;
+      return;
+    }
+
+    // Placeholder results for queries without storage: "visible" and "now" rather than leaving the buffer as it
+    // was (Unreal Engine culls everything its occlusion queries report as 0 samples), zeros for statistics.
     uint64_t stride = Type == D3D12_QUERY_TYPE_PIPELINE_STATISTICS ? sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS)
                       : Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM0 || Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM1 ||
                               Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM2 || Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM3
