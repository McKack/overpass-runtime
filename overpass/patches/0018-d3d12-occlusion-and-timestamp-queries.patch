diff --git a/src/d3d12/d3d12_query_heap.cpp b/src/d3d12/d3d12_query_heap.cpp
index 904c58f..0f987a8 100644
--- a/src/d3d12/d3d12_query_heap.cpp
+++ b/src/d3d12/d3d12_query_heap.cpp
@@ -27,6 +27,30 @@ public:
 
   HRESULT
   Initialize(const D3D12_QUERY_HEAP_DESC *pDesc) {
+    if (!pDesc || !pDesc->Count)
+      return E_INVALIDARG;
+    Type = pDesc->Type;
+    Count = pDesc->Count;
+    // Heaps without storage here (pipeline and stream-output statistics, or a failed allocation) resolve to
+    // placeholder results, see ResolveQueryData.
+    switch (Type) {
+    case D3D12_QUERY_HEAP_TYPE_OCCLUSION: {
+      WMTBufferInfo info{};
+      info.length = sizeof(uint64_t) * Count;
+      info.options = WMTResourceStorageModeShared | WMTResourceHazardTrackingModeUntracked;
+      Results = device_->GetMTLDevice().newBuffer(info);
+      if (Results && info.memory.ptr)
+        memset(info.memory.ptr, 0, info.length);
+      break;
+    }
+    case D3D12_QUERY_HEAP_TYPE_TIMESTAMP:
+      Timestamps = device_->GetMTLDevice().newCounterSampleBuffer(Count, false);
+      if (!Timestamps)
+        WARN("D3D12QueryHeap: no GPU timestamp counters; timestamps come from the CPU clock");
+      break;
+    default:
+      break;
+    }
     return S_OK;
   }
 
