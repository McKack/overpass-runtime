 constexpr auto kCPUHeapSize = 0x400000u;
 constexpr auto kGPUHeapSize = 0x400000u;
+// 64-bit visibility result slots per allocator for occlusion queries (one per run of draws that the same queries count).
+constexpr auto kVisibilitySlots = 0x10000u;
 
 inline std::size_t
 align_forward_adjustment(const void *const ptr, const std::size_t &alignment) noexcept {
@@ -96,6 +98,10 @@ class MTLD3D12CommandAllocatorImpl : public MTLD3D12Pageable<MTLD3D12CommandAllo
   RingBumpState<GpuPrivateBufferBlockAllocator> copy_temp_allocator_;
   uint64_t copy_temp_version_;
 
+  WMT::Reference<WMT::Buffer> visibility_buffer_;
+  uint64_t *visibility_data_ = nullptr;
+  uint32_t visibility_slot_count_ = 0;
+
 public:
   MTLD3D12CommandAllocatorImpl(MTLD3D12Device *pDevice, D3D12_COMMAND_LIST_TYPE Type);
 
@@ -230,6 +236,29 @@ public:
     return {ptr_add(gpu_heap_, aligned), aligned};
   }
 
+  // A new visibility result slot, or the last one again once all are taken (results then overlap, but nothing
+  // that drew reads as hidden).
+  bool
+  AllocateVisibilitySlot(uint32_t &Slot) {
+    if (!visibility_buffer_) {
+      WMTBufferInfo info{};
+      info.length = sizeof(uint64_t) * kVisibilitySlots;
+      info.options = WMTResourceStorageModeShared | WMTResourceHazardTrackingModeUntracked;
+      visibility_buffer_ = device_->GetMTLDevice().newBuffer(info);
+      if (!visibility_buffer_ || !info.memory.ptr) {
+        visibility_buffer_ = {};
+        return false;
+      }
+      visibility_data_ = (uint64_t *)info.memory.ptr;
+      memset(visibility_data_, 0, info.length);
+    }
+    if (visibility_slot_count_ < kVisibilitySlots)
+      Slot = visibility_slot_count_++;
+    else
+      Slot = kVisibilitySlots - 1;
+    return true;
+  }
+
   std::tuple<WMT::Buffer, uint64_t>
   AllocateTempBuffer(size_t Size, size_t Alignment) {
     assert(copy_temp_version_);
diff --git a/src/d3d12/d3d12_command_encoder.hpp b/src/d3d12/d3d12_command_encoder.hpp
index 9fef439..9435e51 100644
--- a/src/d3d12/d3d12_command_encoder.hpp
+++ b/src/d3d12/d3d12_command_encoder.hpp
@@ -32,6 +32,7 @@ enum class EncoderType {
   Compute,
   Resolve,
