From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: McKack <4465550+McKack@users.noreply.github.com>
Date: Mon, 26 Oct 2026 19:46:25 +0100
Subject: [PATCH] d3d12: tessellation, and query results that don't cull
 everything

Pipelines with hull and domain shaders run as Metal mesh pipelines, as DXMT emulates tessellation for D3D11: airconv's vertex-hull function (with the root signatures of both stages) as the object function, the domain shader as the mesh function; one variant per index buffer format, chosen per draw. A pass-through geometry shader after the domain shader is folded into the domain stage; any other one is ignored with a warning, as in D3D11. DrawInstanced and DrawIndexedInstanced with patch-list topologies dispatch one object threadgroup per group of patches and instance. Not yet: tessellated draws through ExecuteIndirect. D3D12 queries still record nothing; ResolveQueryData now writes 'visible' for occlusion queries, the performance counter for timestamps and zeros otherwise, instead of leaving the destination untouched (Unreal Engine culled whatever its queries reported as 0 samples). Verified: Ghostrunner (UE4, D3D12) plays its first level.
---
 src/d3d12/d3d12_command_list.cpp      | 129 ++++++++++++++-
 src/d3d12/d3d12_device.hpp            |   9 ++
 src/d3d12/d3d12_pipeline_graphics.cpp | 216 +++++++++++++++++++++++++-
 3 files changed, 351 insertions(+), 3 deletions(-)

diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index 874e26d..317362f 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -44,6 +44,7 @@ enum class DrawCallStatus {
   Invalid,
   Ordinary,
   Geometry,
+  Tessellation,
 };
 
 inline bool
@@ -702,7 +703,9 @@ public:
       dirty_state_.clr(DirtyState::GraphicsPipelineState);
     }
 
-    auto status = pso_graphics_->is_geometry ? DrawCallStatus::Geometry : DrawCallStatus::Ordinary;
+    auto status = pso_graphics_->is_tessellation ? DrawCallStatus::Tessellation
+                  : pso_graphics_->is_geometry   ? DrawCallStatus::Geometry
+                                                 : DrawCallStatus::Ordinary;
 
     if (dirty_state_.test(DirtyState::VertexBuffer)) {
       auto [Offset, Stride] = PopulateVertexBufferTable(1);
@@ -840,6 +843,62 @@ public:
     D3D12_GPU_VIRTUAL_ADDRESS IndexBuffer;
   };
 
+  struct DXMT_DRAW_ARGUMENTS {
+    UINT VertexCount;
+    UINT InstanceCount;
+    UINT StartVertex;
+    UINT StartInstance;
+  };
+
+  struct DXMT_DRAW_INDEXED_ARGUMENTS {
+    UINT IndexCount;
+    UINT InstanceCount;
+    UINT StartIndex;
+    INT BaseVertex;
+    UINT StartInstance;
+  };
+
+  // A tessellated draw: one object threadgroup per group of patches (32 threads, threads-per-patch of them for
+  // each patch) and instance; the draw arguments and index buffer go to the object (vertex-hull) stage.
+  void
+  TessellationDraw(
+      bool Indexed, uint32_t ControlPointCount, UINT VertexOrIndexCountPerInstance, UINT InstanceCount,
+      uint64_t DrawArgumentsOffset
+  ) {
+    if (!ControlPointCount || !pso_graphics_->tess_threads_per_patch)
+      return;
+    auto patch_count = VertexOrIndexCountPerInstance / ControlPointCount;
+    if (!patch_count || !InstanceCount)
+      return;
+    auto threads_per_patch = pso_graphics_->tess_threads_per_patch;
+    auto patch_per_group = 32 / threads_per_patch;
+    auto group_count = (patch_count - 1) / patch_per_group + 1;
+
+    auto &cmd_setpso = allocator_->EncodeRenderCommand<wmtcmd_render_setpso>();
+    cmd_setpso.type = WMTRenderCommandSetPSO;
+    cmd_setpso.pso = pso_graphics_->GetTessellationVariant(Indexed, index_type);
+
+    auto &cmd_draw_args = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+    cmd_draw_args.type = WMTRenderCommandSetObjectBuffer;
+    cmd_draw_args.buffer = allocator_->gpu_heap_buffer_;
+    cmd_draw_args.offset = DrawArgumentsOffset;
+    cmd_draw_args.index = SM50_BINDING_INDEX_DRAW_ARGUMENTS;
+
+    if (Indexed) {
+      auto &cmd_index_buffer = allocator_->EncodeRenderCommand<wmtcmd_render_setbuffer>();
+      cmd_index_buffer.type = WMTRenderCommandSetObjectBuffer;
+      cmd_index_buffer.buffer = index_buffer;
+      cmd_index_buffer.offset = index_offset;
+      cmd_index_buffer.index = SM50_BINDING_INDEX_INDEX_BUFFER;
+    }
+
+    auto &cmd = allocator_->EncodeRenderCommand<wmtcmd_render_draw_meshthreadgroups>();
+    cmd.type = WMTRenderCommandDrawMeshThreadgroups;
+    cmd.threadgroup_per_grid = {group_count, InstanceCount, 1};
+    cmd.object_threadgroup_size = {threads_per_patch, patch_per_group, 1};
+    cmd.mesh_threadgroup_size = {32, 1, 1};
+  }
+
   void STDMETHODCALLTYPE
   DrawInstanced(UINT VertexCountPerInstance, UINT InstanceCount, UINT StartVertexLocation, UINT StartInstanceLocation) {
     WMTPrimitiveType primitive_type;
@@ -850,6 +909,17 @@ public:
     if (status == DrawCallStatus::Invalid)
       return;
 
+    if (status == DrawCallStatus::Tessellation) {
+      auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(DXMT_DRAW_ARGUMENTS), 32);
+      auto draw_argument = reinterpret_cast<DXMT_DRAW_ARGUMENTS *>(Ptr);
+      draw_argument->VertexCount = VertexCountPerInstance;
+      draw_argument->InstanceCount = InstanceCount;
+      draw_argument->StartVertex = StartVertexLocation;
+      draw_argument->StartInstance = StartInstanceLocation;
+      TessellationDraw(false, cp_count, VertexCountPerInstance, InstanceCount, Offset);
+      return;
+    }
+
     if (status == DrawCallStatus::Geometry) {
       auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(DXMT_DRAW_DYNAMIC_IB_ARGUMENTS), 32);
       DXMT_DRAW_DYNAMIC_IB_ARGUMENTS *draw_argument = reinterpret_cast<DXMT_DRAW_DYNAMIC_IB_ARGUMENTS *>(Ptr);
@@ -918,6 +988,18 @@ public:
     if (status == DrawCallStatus::Invalid)
       return;
 
+    if (status == DrawCallStatus::Tessellation) {
+      auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(DXMT_DRAW_INDEXED_ARGUMENTS), 32);
+      auto draw_argument = reinterpret_cast<DXMT_DRAW_INDEXED_ARGUMENTS *>(Ptr);
+      draw_argument->IndexCount = IndexCountPerInstance;
+      draw_argument->InstanceCount = InstanceCount;
+      draw_argument->StartIndex = StartVertexLocation;
+      draw_argument->BaseVertex = BaseVertexLocation;
+      draw_argument->StartInstance = StartInstanceLocation;
+      TessellationDraw(true, cp_count, IndexCountPerInstance, InstanceCount, Offset);
+      return;
+    }
+
     if (status == DrawCallStatus::Geometry) {
       auto [Ptr, Offset] = allocator_->AllocateGPUHeap(sizeof(DXMT_DRAW_DYNAMIC_IB_ARGUMENTS), 32);
       DXMT_DRAW_DYNAMIC_IB_ARGUMENTS *draw_argument = reinterpret_cast<DXMT_DRAW_DYNAMIC_IB_ARGUMENTS *>(Ptr);
@@ -1879,7 +1961,50 @@ public:
       ID3D12QueryHeap *pHeap, D3D12_QUERY_TYPE Type, UINT StartIndex, UINT QueryCount, ID3D12Resource *pDstBuffer,
       UINT64 AlignedDstBufferOffset
   ) {
-    DEBUG("ResolveQueryData");
+    // Queries don't record anything yet. Until they do, results say "visible" and "no time passed" rather than
+    // leaving the buffer as it was: Unreal Engine culls everything its occlusion queries report as 0 samples.
+    if (!pDstBuffer || !QueryCount || !PreBlit())
+      return;
+    uint64_t stride = Type == D3D12_QUERY_TYPE_PIPELINE_STATISTICS ? sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS)
+                      : Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM0 || Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM1 ||
+                              Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM2 || Type == D3D12_QUERY_TYPE_SO_STATISTICS_STREAM3
+                          ? sizeof(D3D12_QUERY_DATA_SO_STATISTICS)
+                          : sizeof(UINT64);
+    uint64_t value = 0;
+    switch (Type) {
+    case D3D12_QUERY_TYPE_OCCLUSION:
+      value = 0x10000;
+      break;
+    case D3D12_QUERY_TYPE_BINARY_OCCLUSION:
+      value = 1;
+      break;
+    case D3D12_QUERY_TYPE_TIMESTAMP: {
+      // Same clock as GetClockCalibration: the performance counter in nanoseconds.
+      LARGE_INTEGER counter, frequency;
+      QueryPerformanceCounter(&counter);
+      QueryPerformanceFrequency(&frequency);
+      value = (uint64_t)counter.QuadPart / frequency.QuadPart * 1000000000 +
+              (uint64_t)counter.QuadPart % frequency.QuadPart * 1000000000 / frequency.QuadPart;
+      break;
+    }
+    default:
+      break;
+    }
+    auto length = stride * QueryCount;
+    auto [Ptr, Offset] = allocator_->AllocateGPUHeap(length, 16);
+    memset(Ptr, 0, length);
+    if (stride == sizeof(UINT64)) {
+      for (UINT i = 0; i < QueryCount; i++)
+        reinterpret_cast<uint64_t *>(Ptr)[i] = value;
+    }
+
+    auto &cmd_cp = allocator_->EncodeBlitCommand<wmtcmd_blit_copy_from_buffer_to_buffer>();
+    cmd_cp.type = WMTBlitCommandCopyFromBufferToBuffer;
+    cmd_cp.src = allocator_->gpu_heap_buffer_;
+    cmd_cp.dst = static_cast<MTLD3D12Resource *>(pDstBuffer)->buffer->current()->buffer();
+    cmd_cp.src_offset = Offset;
+    cmd_cp.dst_offset = AlignedDstBufferOffset;
+    cmd_cp.copy_length = length;
   };
 
   void STDMETHODCALLTYPE SetPredication(ID3D12Resource *pBuffer, UINT64 AlignedBufferOffset, D3D12_PREDICATION_OP Op) {
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
