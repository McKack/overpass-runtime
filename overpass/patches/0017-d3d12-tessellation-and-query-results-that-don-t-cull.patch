diff --git a/src/d3d12/d3d12_pipeline_graphics.cpp b/src/d3d12/d3d12_pipeline_graphics.cpp
index 069865f..47e5104 100644
--- a/src/d3d12/d3d12_pipeline_graphics.cpp
+++ b/src/d3d12/d3d12_pipeline_graphics.cpp
@@ -1041,6 +1041,218 @@ public:
   }
 };
 
+// Hull and domain shaders as a Metal mesh pipeline, the way D3D11 emulates tessellation: the vertex and hull
+// shaders form the object function, the tessellator and the domain shader the mesh function. Each draw gets the
+// variant for its index buffer format.
+class MTLD3D12TessellationGraphicsPipelineStateImpl : public MTLD3D12GraphicsPipelineStateImpl {
+protected:
+  MTL_SHADER_REFLECTION ref_hs;
+  MTL_SHADER_REFLECTION ref_ds;
+
+  WMT::Reference<WMT::RenderPipelineState> pso_index16;
+  WMT::Reference<WMT::RenderPipelineState> pso_index32;
+
+public:
+  MTLD3D12TessellationGraphicsPipelineStateImpl(MTLD3D12Device *pDevice) :
+      MTLD3D12GraphicsPipelineStateImpl(pDevice) {}
+
+  virtual HRESULT
+  Initialize(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc) {
+    if (pDesc->StreamOutput.NumEntries) {
+      ERR("CreatePipelineState: SO not supported");
+      return E_NOTIMPL;
+    }
+
+    if (!pDesc->VS.pShaderBytecode || !pDesc->HS.pShaderBytecode || !pDesc->DS.pShaderBytecode) {
+      return E_INVALIDARG;
+    }
+
+    HRESULT hr;
+    SM50Shader shader_vs, shader_hs, shader_ds;
+    SM50Error sm50_err;
+    auto metal = device_->GetMTLDevice();
+    WMT::Reference<WMT::Error> err;
+    WMT::Reference<WMT::Function> vshs_func_none, vshs_func_index16, vshs_func_index32, ds_func, ps_func;
+
+    SM50_SHADER_COMMON_DATA common;
+    common.flags = metal.supportsFamily(WMTGPUFamilyApple8) ? SM50_SHADER_FLAG{}
+                                                            : SM50_SHADER_FLAG_NO_NATIVE_ATOMIC64_MINMAX;
+    common.type = SM50_SHADER_COMMON;
+    common.metal_version = SM50_SHADER_METAL_310;
+    common.next = nullptr;
+
+    if (FAILED(hr = InitializeShader(pDesc->VS, &shader_vs, &ref_vs)))
+      return hr;
+    if (FAILED(hr = InitializeShader(pDesc->HS, &shader_hs, &ref_hs)))
+      return hr;
+    if (FAILED(hr = InitializeShader(pDesc->DS, &shader_ds, &ref_ds)))
+      return hr;
+
+    // A geometry shader after the domain shader works when it only passes vertices through (e.g. to pick the
+    // render target slice): the domain stage does its job. Any other one is ignored, as D3D11 does.
+    uint32_t gs_passthrough_data = ~0u;
+    if (pDesc->GS.pShaderBytecode) {
+      SM50Shader shader_gs;
+      MTL_SHADER_REFLECTION ref_gs;
+      if (FAILED(hr = InitializeShader(pDesc->GS, &shader_gs, &ref_gs)))
+        return hr;
+      gs_passthrough_data = ref_gs.GeometryShader.GSPassThrough;
+      if (gs_passthrough_data == ~0u)
+        WARN("CreatePipelineState: geometry shader after tessellation isn't a pass-through one; ignored");
+    }
+
+    uint32_t max_potential_factor = ref_ds.PostTessellator.MaxPotentialTessFactor;
+    if (!metal.supportsFamily(WMTGPUFamilyApple9))
+      max_potential_factor = std::min(8u, max_potential_factor);
+    if ((float)max_potential_factor < ref_hs.Tessellator.MaxFactor) {
+      WARN("maxtessfactor(", ref_hs.Tessellator.MaxFactor, ") is too large for a mesh pipeline. Clamping to ",
+           max_potential_factor);
+    }
+
+    // Each stage binds its resources through the root signature, or through the one embedded in its shader.
+    auto root_signature = [&](const D3D12_SHADER_BYTECODE &Shader, SM50_SHADER_COMPILATION_ARGUMENT_TYPE Type,
+                              void *Next) {
+      SM50_SHADER_ROOT_SIGNATURE_DATA rootsig;
+      rootsig.type = Type;
+      if (pDesc->pRootSignature) {
+        rootsig.bytecode_length =
+            static_cast<MTLD3D12RootSignature *>(pDesc->pRootSignature)->GetBlob(&rootsig.bytecode);
+      } else {
+        rootsig.bytecode = Shader.pShaderBytecode;
+        rootsig.bytecode_length = Shader.BytecodeLength;
+      }
+      rootsig.next = Next;
+      return rootsig;
+    };
+
+    SM50_SHADER_PSO_TESSELLATOR_DATA tessellator;
+    tessellator.type = SM50_SHADER_PSO_TESSELLATOR;
+    tessellator.max_potential_tess_factor = max_potential_factor;
+
+    {
+      SM50_SHADER_IA_INPUT_LAYOUT_DATA data_ia_layout;
+      data_ia_layout.type = SM50_SHADER_IA_INPUT_LAYOUT;
+      std::vector<SM50_IA_INPUT_ELEMENT> elements(pDesc->InputLayout.NumElements);
+      if (FAILED(
+              hr = ExtractMTLInputLayoutElements(
+                  device_, pDesc->VS.pShaderBytecode, pDesc->InputLayout.pInputElementDescs,
+                  pDesc->InputLayout.NumElements, elements.data(), &data_ia_layout.num_elements
+              )
+          ))
+        return hr;
+      elements.resize(data_ia_layout.num_elements);
+      data_ia_layout.elements = elements.data();
+      slot_mask = 0;
+      for (auto &element : elements) {
+        slot_mask |= (1 << element.slot);
+      }
+      data_ia_layout.slot_mask = slot_mask;
+
+      auto rootsig_vs = root_signature(pDesc->VS, SM50_SHADER_ROOT_SIGNATURE2, &common);
+      auto rootsig_hs = root_signature(pDesc->HS, SM50_SHADER_ROOT_SIGNATURE, &rootsig_vs);
+      tessellator.next = &rootsig_hs;
+      data_ia_layout.next = &tessellator;
+
+      auto compile_vshs = [&](SM50_INDEX_BUFFER_FORMAT IndexFormat) -> WMT::Reference<WMT::Function> {
+        data_ia_layout.index_buffer_format = IndexFormat;
+        SM50ShaderBitcode vshs_bitcode;
+        if (SM50CompileTessellationPipelineHull(
+                shader_vs, shader_hs, (SM50_SHADER_COMPILATION_ARGUMENT_DATA *)&data_ia_layout, "vshs_main",
+                &vshs_bitcode, &sm50_err
+            )) {
+          ERR("Failed to compile vertex-hull shader: ", SM50GetErrorMessageString(sm50_err));
+          SM50FreeError(sm50_err);
+          return {};
+        }
+        SM50_COMPILED_BITCODE vshs_bitcode_compiled;
+        SM50GetCompiledBitcode(vshs_bitcode, &vshs_bitcode_compiled);
+        auto vshs_data = WMT::MakeDispatchData(vshs_bitcode_compiled.Data, vshs_bitcode_compiled.Size);
+        auto vshs_lib = metal.newLibrary(vshs_data, err);
+        return vshs_lib.newFunction("vshs_main");
+      };
+
+      if (!(vshs_func_none = compile_vshs(SM50_INDEX_BUFFER_FORMAT_NONE)) ||
+          !(vshs_func_index16 = compile_vshs(SM50_INDEX_BUFFER_FORMAT_UINT16)) ||
+          !(vshs_func_index32 = compile_vshs(SM50_INDEX_BUFFER_FORMAT_UINT32)))
+        return E_FAIL;
+    }
+    {
+      auto rootsig_ds = root_signature(pDesc->DS, SM50_SHADER_ROOT_SIGNATURE, &common);
+      tessellator.next = &rootsig_ds;
+
+      SM50_SHADER_GS_PASS_THROUGH_DATA gs_passthrough;
+      gs_passthrough.type = SM50_SHADER_GS_PASS_THROUGH;
+      gs_passthrough.DataEncoded = gs_passthrough_data;
+      gs_passthrough.RasterizationDisabled = false;
+      gs_passthrough.next = &tessellator;
+
+      SM50ShaderBitcode ds_bitcode;
+      if (SM50CompileTessellationPipelineDomain(
+              shader_hs, shader_ds, (SM50_SHADER_COMPILATION_ARGUMENT_DATA *)&gs_passthrough, "ds_main", &ds_bitcode,
+              &sm50_err
+          )) {
+        ERR("Failed to compile domain shader: ", SM50GetErrorMessageString(sm50_err));
+        SM50FreeError(sm50_err);
+        return E_FAIL;
+      }
+      SM50_COMPILED_BITCODE ds_bitcode_compiled;
+      SM50GetCompiledBitcode(ds_bitcode, &ds_bitcode_compiled);
+      auto ds_data = WMT::MakeDispatchData(ds_bitcode_compiled.Data, ds_bitcode_compiled.Size);
+      auto ds_lib = metal.newLibrary(ds_data, err);
+      if (!(ds_func = ds_lib.newFunction("ds_main")))
+        return E_FAIL;
+    }
+
+    WMTMeshRenderPipelineInfo info;
+    WMT::InitializeMeshRenderPipelineInfo(info);
+
+    bool dual_source_blending = false;
+    if (FAILED(hr = InitializePSO(pDesc, info, dual_source_blending)))
+      return hr;
+    if (FAILED(hr = CompilePixelShader(pDesc, info, dual_source_blending, common, ps_func)))
+      return hr;
+    if (!ps_func)
+      ps_func = device_->GetLib().getLibrary().newFunction("fs_empty");
+
+    info.mesh_function = ds_func.handle;
+    info.fragment_function = ps_func.handle;
+    info.payload_memory_length = 0;
+    // As D3D11 does on AMD GPUs: reserve the whole payload.
+    if (!metal.supportsFamily(WMTGPUFamilyApple7))
+      info.payload_memory_length = 16384;
+    // The mesh threadgroup is 32 threads, the object threadgroup threads-per-patch x patches-per-group = 32.
+    info.mesh_tgsize_is_multiple_of_sgwidth = true;
+    info.object_tgsize_is_multiple_of_sgwidth = true;
+
+    auto compile_pso = [&](WMT::Function vshs_func) -> WMT::Reference<WMT::RenderPipelineState> {
+      info.object_function = vshs_func.handle;
+      auto pso = metal.newRenderPipelineState(info, err);
+      if (!pso)
+        ERR("Failed to create tessellation PSO: ", err.description().getUTF8String());
+      return pso;
+    };
+
+    if (!(pso = compile_pso(vshs_func_none)) || !(pso_index16 = compile_pso(vshs_func_index16)) ||
+        !(pso_index32 = compile_pso(vshs_func_index32)))
+      return E_FAIL;
+
+    InitializeDSSO(pDesc);
+    InitializeRasterizerState(pDesc);
+
+    is_tessellation = true;
+    tess_threads_per_patch = ref_hs.ThreadsPerPatch;
+
+    return S_OK;
+  }
+
+  virtual WMT::RenderPipelineState
+  GetTessellationVariant(bool Indexed, WMTIndexType IndexType) {
+    if (!Indexed)
+      return pso;
+    return IndexType == WMTIndexTypeUInt16 ? pso_index16 : pso_index32;
+  }
+};
+
 HRESULT
 CreateGraphicsPipelineState(
     MTLD3D12Device *pDevice, const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc, REFIID riid, void **ppPipelineState,
@@ -1048,7 +1260,9 @@ CreateGraphicsPipelineState(
 ) {
   InitReturnPtr(ppPipelineState);
   Com<MTLD3D12GraphicsPipelineStateImpl> pso;
-  if (pDesc->GS.pShaderBytecode)
+  if (pDesc->HS.pShaderBytecode || pDesc->DS.pShaderBytecode)
+    pso = Com<MTLD3D12GraphicsPipelineStateImpl>(new MTLD3D12TessellationGraphicsPipelineStateImpl(pDevice));
+  else if (pDesc->GS.pShaderBytecode)
     pso = Com<MTLD3D12GraphicsPipelineStateImpl>(new MTLD3D12GeometryGraphicsPipelineStateImpl(pDevice));
   else
     pso = Com(new MTLD3D12GraphicsPipelineStateImpl(pDevice));
-- 
