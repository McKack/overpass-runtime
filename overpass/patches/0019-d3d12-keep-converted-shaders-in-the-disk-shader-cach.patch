diff --git a/src/d3d12/d3d12_shader_cache.hpp b/src/d3d12/d3d12_shader_cache.hpp
new file mode 100644
index 0000000..65b0793
--- /dev/null
+++ b/src/d3d12/d3d12_shader_cache.hpp
@@ -0,0 +1,129 @@
+#pragma once
+
+#include "d3d12_pipeline.hpp"
+#include "dxmt_shader_cache.hpp"
+#include "sha1/sha1_util.hpp"
+#include "d3d12.h"
+#include <cstring>
+#include <initializer_list>
+
+namespace dxmt {
+
+// airconv's output for D3D12 shaders, kept in DXMT's disk cache as D3D11's is, so a shader is converted once
+// rather than every time the game starts (Metal caches its own compile of the result). The key covers the
+// shaders the conversion reads, the entry point and every compile argument.
+class D3D12ShaderCacheKey {
+public:
+  D3D12ShaderCacheKey(std::initializer_list<D3D12_SHADER_BYTECODE> Shaders, const char *FunctionName) {
+    hash_.update("d3d12", 5);
+    for (auto &shader : Shaders) {
+      hash_.update(shader.BytecodeLength);
+      hash_.update(shader.pShaderBytecode, shader.BytecodeLength);
+    }
+    hash_.update(FunctionName, strlen(FunctionName) + 1);
+  }
+
+  // False for an argument the key doesn't know: that conversion goes without the cache.
+  bool
+  AddArguments(const SM50_SHADER_COMPILATION_ARGUMENT_DATA *Args) {
+    for (auto arg = Args; arg; arg = (const SM50_SHADER_COMPILATION_ARGUMENT_DATA *)arg->next) {
+      hash_.update(arg->type);
+      switch (arg->type) {
+      case SM50_SHADER_COMMON: {
+        auto data = (const SM50_SHADER_COMMON_DATA *)arg;
+        hash_.update(data->metal_version);
+        hash_.update(data->flags);
+        break;
+      }
+      case SM50_SHADER_PSO_PIXEL_SHADER: {
+        auto data = (const SM50_SHADER_PSO_PIXEL_SHADER_DATA *)arg;
+        hash_.update(data->sample_mask);
+        hash_.update(data->dual_source_blending);
+        hash_.update(data->disable_depth_output);
+        hash_.update(data->unorm_output_reg_mask);
+        hash_.update(data->pixel_formats);
+        break;
+      }
+      case SM50_SHADER_IA_INPUT_LAYOUT: {
+        auto data = (const SM50_SHADER_IA_INPUT_LAYOUT_DATA *)arg;
+        hash_.update(data->index_buffer_format);
+        hash_.update(data->slot_mask);
+        hash_.update(data->num_elements);
+        for (uint32_t i = 0; i < data->num_elements; i++) {
+          auto &element = data->elements[i];
+          hash_.update(element.reg);
+          hash_.update(element.slot);
+          hash_.update(element.aligned_byte_offset);
+          hash_.update(element.format);
+          hash_.update(uint32_t(element.step_function));
+          hash_.update(uint32_t(element.step_rate));
+        }
+        break;
+      }
+      case SM50_SHADER_GS_PASS_THROUGH: {
+        auto data = (const SM50_SHADER_GS_PASS_THROUGH_DATA *)arg;
+        hash_.update(data->DataEncoded);
+        hash_.update(data->RasterizationDisabled);
+        break;
+      }
+      case SM50_SHADER_PSO_GEOMETRY_SHADER:
+        hash_.update(((const SM50_SHADER_PSO_GEOMETRY_SHADER_DATA *)arg)->strip_topology);
+        break;
+      case SM50_SHADER_PSO_TESSELLATOR:
+        hash_.update(((const SM50_SHADER_PSO_TESSELLATOR_DATA *)arg)->max_potential_tess_factor);
+        break;
+      case SM50_SHADER_ROOT_SIGNATURE:
+      case SM50_SHADER_ROOT_SIGNATURE2: {
+        auto data = (const SM50_SHADER_ROOT_SIGNATURE_DATA *)arg;
+        hash_.update(data->bytecode_length);
+        hash_.update(data->bytecode, data->bytecode_length);
+        break;
+      }
+      default:
+        return false;
+      }
+    }
+    return true;
+  }
+
+  Sha1Digest
+  Digest() {
+    return hash_.final();
+  }
+
+private:
+  Sha1HashState hash_;
+};
+
+// Converts a shader with `Compile` (an SM50Compile* call taking the bitcode and error out-parameters), or takes
+// the conversion from the cache. Null when the conversion fails; `Error` then says why.
+template <typename CompileFn>
+WMT::Reference<WMT::DispatchData>
+CompileShaderCached(
+    std::initializer_list<D3D12_SHADER_BYTECODE> Shaders, SM50_SHADER_COMPILATION_ARGUMENT_DATA *Args,
+    const char *FunctionName, SM50Error &Error, CompileFn &&Compile
+) {
+  auto &cache = ShaderCache::getInstance(WMTMetal310);
+  D3D12ShaderCacheKey key(Shaders, FunctionName);
+  bool cacheable = key.AddArguments(Args);
+  Sha1Digest digest = key.Digest();
+  if (cacheable) {
+    if (auto reader = cache.getReader()) {
+      if (auto data = reader->get(digest))
+        return data;
+    }
+  }
+  SM50ShaderBitcode bitcode;
+  if (Compile(&bitcode, &Error))
+    return {};
+  SM50_COMPILED_BITCODE compiled;
+  SM50GetCompiledBitcode(bitcode, &compiled);
+  auto data = WMT::MakeDispatchData(compiled.Data, compiled.Size);
+  if (cacheable) {
+    if (auto writer = cache.getWriter())
+      writer->set(digest, data);
+  }
+  return data;
+}
+
+} // namespace dxmt
