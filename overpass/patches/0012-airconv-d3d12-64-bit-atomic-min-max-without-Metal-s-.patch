diff --git a/src/airconv/nt/dxil_converter_base.cpp b/src/airconv/nt/dxil_converter_base.cpp
index c5a88b4..ba07587 100644
--- a/src/airconv/nt/dxil_converter_base.cpp
+++ b/src/airconv/nt/dxil_converter_base.cpp
@@ -2414,7 +2414,7 @@ Converter::EmitAtomicCmpXchg(const CallInst &Call) {
 }
 
 bool
-Atomic64NeedsLock(AtomicRMWInst::BinOp Op, bool CompareExchange, bool ResultUsed, bool Threadgroup) {
+Atomic64NeedsLock(AtomicRMWInst::BinOp Op, bool CompareExchange, bool ResultUsed, bool Threadgroup, bool NativeMinMax) {
   if (CompareExchange)
     return true;
   switch (Op) {
@@ -2425,14 +2425,14 @@ Atomic64NeedsLock(AtomicRMWInst::BinOp Op, bool CompareExchange, bool ResultUsed
     return false;
   case AtomicRMWInst::UMin:
   case AtomicRMWInst::UMax:
-    return Threadgroup || ResultUsed;
+    return Threadgroup || ResultUsed || !NativeMinMax;
   default:
     return true;
   }
 }
 
 bool
-DxilAtomic64NeedsLock(const CallInst &Call) {
+DxilAtomic64NeedsLock(const CallInst &Call, bool NativeMinMax) {
   if (!Call.getType()->isIntegerTy(64))
     return false;
   auto Opcode = asU32(Call.getArgOperand(0));
@@ -2442,14 +2442,13 @@ DxilAtomic64NeedsLock(const CallInst &Call) {
     return false;
   switch (asU32(Call.getArgOperand(2)).value_or(~0u)) {
   case kAtomicOpAdd:
-    return Atomic64NeedsLock(AtomicRMWInst::Add, false, false, false);
   case kAtomicOpAnd:
   case kAtomicOpOr:
   case kAtomicOpXor:
     return false;
   case kAtomicOpUMin:
   case kAtomicOpUMax:
-    return !Call.use_empty();
+    return !NativeMinMax || !Call.use_empty();
   default:
     return true;
   }
@@ -2495,9 +2494,12 @@ Converter::InitializeLocalAtomic64Locks() {
     for (auto &Inst : BB) {
       if (auto *RMW = dyn_cast<AtomicRMWInst>(&Inst))
         local_atomic64_locked_ |= RMW->getValOperand()->getType()->isIntegerTy(64) &&
-                                  Atomic64NeedsLock(RMW->getOperation(), false, !RMW->use_empty(), true);
+                                  Atomic64NeedsLock(RMW->getOperation(), false, !RMW->use_empty(), true, false);
       if (auto *CmpXchg = dyn_cast<AtomicCmpXchgInst>(&Inst))
         local_atomic64_locked_ |= CmpXchg->getNewValOperand()->getType()->isIntegerTy(64);
+      if (auto *Call = dyn_cast<CallInst>(&Inst))
+        if (Call->getCalledFunction() && Call->getCalledFunction()->getName().startswith("dx.op."))
+          device_atomic64_locked_ |= DxilAtomic64NeedsLock(*Call, !air.getOptions().noNativeAtomic64MinMax);
     }
   if (!local_atomic64_locked_)
     return;
@@ -2527,9 +2529,9 @@ Converter::EmitAtomic64(AtomicRMWInst::BinOp Op, Value *Ptr, Value *Val, Value *
 
   // A shader takes the lock for all of its 64-bit atomics in one address space once any of them needs it, so that
   // they stay atomic with respect to each other.
-  auto *DeviceLocks = Local ? nullptr : ctx.binding.GetAtomic64LockTable(air);
-  bool Locked = Local ? local_atomic64_locked_ : DeviceLocks != nullptr;
-  if (Atomic64NeedsLock(Op, Compare != nullptr, ResultUsed, Local) && !Locked)
+  bool Locked = Local ? local_atomic64_locked_ : device_atomic64_locked_;
+  auto *DeviceLocks = Local || !Locked ? nullptr : ctx.binding.GetAtomic64LockTable(air);
+  if (Locked && !Local && !DeviceLocks)
     return unsupported("dxil: 64-bit atomic without a lock table");
 
   if (!Locked) {
diff --git a/src/airconv/nt/dxil_converter_base.hpp b/src/airconv/nt/dxil_converter_base.hpp
index 798009f..368e894 100644
--- a/src/airconv/nt/dxil_converter_base.hpp
+++ b/src/airconv/nt/dxil_converter_base.hpp
@@ -119,6 +119,7 @@ private:
 
   // 64-bit atomics (SM 6.6), see EmitAtomic64.
   bool local_atomic64_locked_ = false;
+  bool device_atomic64_locked_ = false;
   llvm::GlobalVariable *local_atomic64_locks_ = nullptr;
   void InitializeLocalAtomic64Locks();
   llvm::Expected<llvm::Value *> EmitAtomic64(
@@ -129,8 +130,11 @@ private:
 
 // Metal has 64-bit atomics only as unsigned min/max without a result, on device memory. Add/and/or/xor are split
 // into two 32-bit atomics; everything else takes a lock word. True when this operation needs the lock.
-bool Atomic64NeedsLock(llvm::AtomicRMWInst::BinOp Op, bool CompareExchange, bool ResultUsed, bool Threadgroup);
-// The same decision for a dx.op.atomicBinOp / dx.op.atomicCompareExchange call.
-bool DxilAtomic64NeedsLock(const llvm::CallInst &Call);
+bool Atomic64NeedsLock(
+    llvm::AtomicRMWInst::BinOp Op, bool CompareExchange, bool ResultUsed, bool Threadgroup, bool NativeMinMax
+);
+// The same decision for a dx.op.atomicBinOp / dx.op.atomicCompareExchange call; NativeMinMax: the GPU has Metal's
+// 64-bit min/max.
+bool DxilAtomic64NeedsLock(const llvm::CallInst &Call, bool NativeMinMax);
 
 } // namespace dxmt::dxil
diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index b130151..c9f3f2a 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -406,7 +406,8 @@ public:
       if (DataSize != sizeof(D3D12_FEATURE_DATA_D3D12_OPTIONS11))
         return E_INVALIDARG;
       auto *out = reinterpret_cast<D3D12_FEATURE_DATA_D3D12_OPTIONS11 *>(pFeatureData);
-      out->AtomicInt64OnDescriptorHeapResourceSupported = FALSE;
+      // Heap buffers reach the same lock table as other buffers.
+      out->AtomicInt64OnDescriptorHeapResourceSupported = TRUE;
       return S_OK;
     }
     case D3D12_FEATURE_SHADER_CACHE: {
diff --git a/src/d3d12/d3d12_pipeline_compute.cpp b/src/d3d12/d3d12_pipeline_compute.cpp
