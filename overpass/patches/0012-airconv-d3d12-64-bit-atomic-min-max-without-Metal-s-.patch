@@ -51,7 +51,10 @@ public:
     rootsig.next = nullptr;
 
     SM50_SHADER_COMMON_DATA common;
-    common.flags = {};
+    // Metal's 64-bit atomic min/max needs Apple8 (M2) or later; airconv takes a lock otherwise.
+    common.flags = device_->GetMTLDevice().supportsFamily(WMTGPUFamilyApple8)
+                       ? SM50_SHADER_FLAG{}
+                       : SM50_SHADER_FLAG_NO_NATIVE_ATOMIC64_MINMAX;
     common.type = SM50_SHADER_COMMON;
     common.metal_version = SM50_SHADER_METAL_310;
     common.next = &rootsig;
diff --git a/src/d3d12/d3d12_pipeline_graphics.cpp b/src/d3d12/d3d12_pipeline_graphics.cpp
index 920f523..54da527 100644
--- a/src/d3d12/d3d12_pipeline_graphics.cpp
+++ b/src/d3d12/d3d12_pipeline_graphics.cpp
@@ -487,7 +487,10 @@ public:
     WMT::Reference<WMT::Function> vs_func, ps_func;
 
     SM50_SHADER_COMMON_DATA common;
-    common.flags = {};
+    // Metal's 64-bit atomic min/max needs Apple8 (M2) or later; airconv takes a lock otherwise.
+    common.flags = device_->GetMTLDevice().supportsFamily(WMTGPUFamilyApple8)
+                       ? SM50_SHADER_FLAG{}
+                       : SM50_SHADER_FLAG_NO_NATIVE_ATOMIC64_MINMAX;
     common.type = SM50_SHADER_COMMON;
     common.metal_version = SM50_SHADER_METAL_310;
     common.next = nullptr;
