           return err;
-        shader_info.use_atomic64_locks |= DxilAtomic64NeedsLock(*ci);
+        shader_info.use_atomic64_locks |= ci->getType()->isIntegerTy(64);
         break;
       case kOpSample:
       case kOpSampleBias:
