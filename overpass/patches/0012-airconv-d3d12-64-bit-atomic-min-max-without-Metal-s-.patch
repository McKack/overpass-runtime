 src/airconv/nt/dxil_converter_base.hpp | 10 +++++++---
 src/d3d12/d3d12_device.cpp             |  3 ++-
 src/d3d12/d3d12_pipeline_compute.cpp   |  5 ++++-
 src/d3d12/d3d12_pipeline_graphics.cpp  |  5 ++++-
 13 files changed, 51 insertions(+), 17 deletions(-)

diff --git a/src/airconv/airconv_cli.cpp b/src/airconv/airconv_cli.cpp
index 7f08bb5..0b903d8 100644
--- a/src/airconv/airconv_cli.cpp
+++ b/src/airconv/airconv_cli.cpp
@@ -56,6 +56,10 @@ static cl::opt<bool> UseRootSignature(
   "rootsig", cl::init(false), cl::desc("Bind resources through the root signature embedded in the input (D3D12)")
 );
 
+static cl::opt<bool> NoNativeAtomic64MinMax(
+  "no-native-atomic64-minmax", cl::init(false), cl::desc("Compile for a GPU without 64-bit atomic min/max (before Apple8)")
+);
+
 static cl::opt<bool> DisassembleDXBC(
   "disas-dxbc", cl::init(false), cl::desc("Disassemble dxbc shader")
 );
@@ -230,6 +234,8 @@ int main(int argc, char **argv) {
   rootsig.bytecode = MemRef.getBufferStart();
   rootsig.bytecode_length = MemRef.getBufferSize();
   rootsig.next = nullptr;
+  if (NoNativeAtomic64MinMax)
+    data.flags = SM50_SHADER_FLAG_NO_NATIVE_ATOMIC64_MINMAX;
   if (UseRootSignature) {
     data.metal_version = SM50_SHADER_METAL_310; // as d3d12 compiles pipelines
     data.next = &rootsig;
