diff --git a/src/d3d12/d3d12_command_encoder.hpp b/src/d3d12/d3d12_command_encoder.hpp
index 1caf3bc..9fef439 100644
--- a/src/d3d12/d3d12_command_encoder.hpp
+++ b/src/d3d12/d3d12_command_encoder.hpp
@@ -18,6 +18,7 @@
 
 #pragma once
 
+#include "dxmt_scaler.hpp"
 #include "dxmt_texture.hpp"
 #include <cstdint>
 
@@ -30,6 +31,7 @@ enum class EncoderType {
   Blit,
   Compute,
   Resolve,
+  TemporalUpscale,
 };
 
 struct EncoderData {
@@ -119,4 +121,16 @@ struct ResolveEncoderData : EncoderData {
   TextureViewRef dst;
 };
 
+// A MetalFX temporal upscale. Motion vectors are already at input resolution (a compute pass before it
+// shrinks display-resolution ones).
+struct TemporalUpscaleEncoderData : EncoderData {
+  TextureViewRef input;
+  TextureViewRef output;
+  TextureViewRef depth;
+  TextureViewRef motion_vector;
+  TextureViewRef exposure;
+  Rc<TemporalScaler> scaler;
+  WMTFXTemporalScalerProps props;
+};
+
 }; // namespace dxmt
diff --git a/src/d3d12/d3d12_command_list.cpp b/src/d3d12/d3d12_command_list.cpp
index c658791..e68dd36 100644
--- a/src/d3d12/d3d12_command_list.cpp
+++ b/src/d3d12/d3d12_command_list.cpp
@@ -17,6 +17,7 @@
  */
 
 #include "d3d12_command_allocator.hpp"
+#include "d3d12_interfaces.hpp"
 #include "com/com_pointer.hpp"
 #include "dxmt_format.hpp"
 
@@ -230,6 +231,193 @@ class MTLD3D12GraphicsCommandListImpl : public MTLD3D12DeviceChild<MTLD3D12Graph
   FLOAT blend_factor_[4];
   UINT8 stencil_ref_;
 
+  // IMTLD3D12CommandListExt, used by nvngx for DLSS -> MetalFX.
+  class CommandListExt final : public IMTLD3D12CommandListExt {
+    MTLD3D12GraphicsCommandListImpl *list_;
+
+  public:
+    CommandListExt(MTLD3D12GraphicsCommandListImpl *list) : list_(list) {}
+
+    HRESULT STDMETHODCALLTYPE
+    QueryInterface(REFIID riid, void **ppvObject) final {
+      return list_->QueryInterface(riid, ppvObject);
+    }
+    ULONG STDMETHODCALLTYPE
+    AddRef() final {
+      return list_->AddRef();
+    }
+    ULONG STDMETHODCALLTYPE
+    Release() final {
+      return list_->Release();
+    }
+
+    BOOL STDMETHODCALLTYPE
+    TemporalUpscale(const MTL_TEMPORAL_UPSCALE_D3D12_DESC *pDesc) final {
+      return pDesc && list_->TemporalUpscale(*pDesc);
+    }
+
+    HRESULT STDMETHODCALLTYPE
+    CheckFeatureSupport(MTL_D3D12_FEATURE Feature, void *pFeatureSupportData, UINT FeatureSupportDataSize) final {
+      if (!pFeatureSupportData)
+        return E_INVALIDARG;
+      switch (Feature) {
+      case MTL_D3D12_FEATURE_METALFX_TEMPORAL_SCALER:
+        if (FeatureSupportDataSize != sizeof(BOOL))
+          return E_INVALIDARG;
+        *reinterpret_cast<BOOL *>(pFeatureSupportData) = list_->device_->GetMTLDevice().supportsFXTemporalScaler();
+        return S_OK;
+      }
+      return E_INVALIDARG;
+    }
+  } ext_{this};
+
+  // Motion vector formats MetalFX accepts, from the formats games render them in.
+  static WMTPixelFormat
+  MotionVectorFormat(WMTPixelFormat format) {
+    switch (format) {
+    case WMTPixelFormatRG16Uint:
+    case WMTPixelFormatRG16Float:
+    case WMTPixelFormatRG16Sint:
+    case WMTPixelFormatRG16Snorm:
+    case WMTPixelFormatRG16Unorm:
+      return WMTPixelFormatRG16Float;
+    case WMTPixelFormatRG32Uint:
+    case WMTPixelFormatRG32Float:
+    case WMTPixelFormatRG32Sint:
+      return WMTPixelFormatRG32Float;
+    case WMTPixelFormatRGBA16Sint:
+    case WMTPixelFormatRGBA16Snorm:
+    case WMTPixelFormatRGBA16Uint:
+    case WMTPixelFormatRGBA16Unorm:
+    case WMTPixelFormatRGBA16Float:
+      return WMTPixelFormatRGBA16Float;
+    default:
+      return WMTPixelFormatInvalid;
+    }
+  }
+
+  // The first mip and slice of a texture as a plain 2D view, which is what MetalFX takes.
+  static TextureViewRef
+  View2D(const Rc<Texture> &texture, WMTPixelFormat format) {
+    auto key = texture->createView(
+        {.format = format,
+         .type = WMTTextureType2D,
+         .firstMiplevel = 0,
+         .miplevelCount = 1,
+         .firstArraySlice = 0,
+         .arraySize = 1}
+    );
+    return &texture->view(key);
+  }
+
+  BOOL
+  TemporalUpscale(const MTL_TEMPORAL_UPSCALE_D3D12_DESC &Desc) {
+    auto texture_of = [](ID3D12Resource *pResource) -> Rc<Texture> {
+      return pResource ? static_cast<MTLD3D12Resource *>(pResource)->texture : nullptr;
+    };
+    Rc<Texture> input = texture_of(Desc.Color), output = texture_of(Desc.Output), depth = texture_of(Desc.Depth),
+                motion_vector = texture_of(Desc.MotionVector), exposure = texture_of(Desc.ExposureTexture);
+    if (!input || !output || !depth || !motion_vector || (Desc.ExposureTexture && !exposure))
+      return FALSE;
+
+    auto motion_vector_format = MotionVectorFormat(motion_vector->pixelFormat());
+    if (motion_vector_format == WMTPixelFormatInvalid) {
+      ERR("TemporalUpscale: unsupported motion vector format ", motion_vector->pixelFormat());
+      return FALSE;
+    }
+
+    WMTFXTemporalScalerInfo info{};
+    info.color_format = input->pixelFormat();
+    info.output_format = output->pixelFormat();
+    info.depth_format = depth->pixelFormat();
+    info.motion_format = motion_vector_format;
+    info.input_width = input->width();
+    info.input_height = input->height();
+    info.output_width = output->width();
+    info.output_height = output->height();
+    info.auto_exposure = Desc.AutoExposure;
+    info.input_content_properties_enabled = true;
+    info.input_content_min_scale = 1.0f;
+    info.input_content_max_scale = 3.0f;
+    info.requires_synchronous_initialization = true;
+    auto scaler = device_->GetTemporalScaler(info, Desc.MotionVectorInDisplayRes);
+
+    WMTFXTemporalScalerProps props{
+        Desc.InputContentWidth ? Desc.InputContentWidth : input->width(),
+        Desc.InputContentHeight ? Desc.InputContentHeight : input->height(),
+        (bool)Desc.InReset,
+        (bool)Desc.DepthReversed,
+        Desc.MotionVectorScaleX,
+        Desc.MotionVectorScaleY,
+        Desc.JitterOffsetX,
+        Desc.JitterOffsetY,
+        Desc.PreExposure,
+    };
+
+    allocator_->InvalidateCurrentPass();
+    auto motion_vector_view = View2D(motion_vector, motion_vector_format);
+
+    // MetalFX wants motion vectors at render size; shrink display-size ones first, applying their scale.
+    if (scaler.motion_vector_lowres) {
+      auto pso = device_->GetMotionVectorDownscalePipeline();
+      if (!pso)
+        return FALSE;
+      auto lowres_view = View2D(scaler.motion_vector_lowres, motion_vector_format);
+
+      auto compute = allocator_->AllocatePass<ComputeEncoderData>();
+      compute->type = EncoderType::Compute;
+      compute->cmd_head.type = WMTComputeCommandNop;
+      compute->cmd_head.next.set(0);
+      compute->cmd_tail = (wmtcmd_base *)&compute->cmd_head;
+
+      auto &setpso = allocator_->EncodeComputeCommand<wmtcmd_compute_setpso>();
+      setpso.type = WMTComputeCommandSetPSO;
+      setpso.pso = pso;
+      setpso.threadgroup_size = {8, 4, 1};
+
+      auto &set_source = allocator_->EncodeComputeCommand<wmtcmd_compute_settexture>();
+      set_source.type = WMTComputeCommandSetTexture;
+      set_source.texture = motion_vector_view.texture();
+      set_source.index = 0;
+
+      auto &set_target = allocator_->EncodeComputeCommand<wmtcmd_compute_settexture>();
+      set_target.type = WMTComputeCommandSetTexture;
+      set_target.texture = lowres_view.texture();
+      set_target.index = 1;
+
+      auto scale = allocator_->AllocateCommandData<float>(2);
+      scale[0] = props.motion_vector_scale_x;
+      scale[1] = props.motion_vector_scale_y;
+      auto &set_scale = allocator_->EncodeComputeCommand<wmtcmd_compute_setbytes>();
+      set_scale.type = WMTComputeCommandSetBytes;
+      set_scale.bytes.set(scale);
+      set_scale.length = sizeof(float) * 2;
+      set_scale.index = 0;
+
+      auto &dispatch = allocator_->EncodeComputeCommand<wmtcmd_compute_dispatch>();
+      dispatch.type = WMTComputeCommandDispatchThreads;
+      dispatch.size = {info.input_width, info.input_height, 1};
+
+      allocator_->InvalidateCurrentPass();
+      motion_vector_view = lowres_view;
+      props.motion_vector_scale_x = 1.0f;
+      props.motion_vector_scale_y = 1.0f;
+    }
+
+    auto upscale = allocator_->AllocatePass<TemporalUpscaleEncoderData>();
+    upscale->type = EncoderType::TemporalUpscale;
+    upscale->input = View2D(input, input->pixelFormat());
+    upscale->output = View2D(output, output->pixelFormat());
+    upscale->depth = View2D(depth, depth->pixelFormat());
+    upscale->motion_vector = motion_vector_view;
+    if (exposure)
+      upscale->exposure = View2D(exposure, exposure->pixelFormat());
+    upscale->scaler = scaler.scaler;
+    upscale->props = props;
+    allocator_->InvalidateCurrentPass();
+    return TRUE;
+  }
+
 public:
   MTLD3D12GraphicsCommandListImpl(MTLD3D12Device *pDevice) : MTLD3D12DeviceChild<MTLD3D12GraphicsCommandList>(pDevice) {}
 
@@ -308,6 +496,11 @@ public:
       return S_OK;
     }
 
+    if (riid == __uuidof(IMTLD3D12CommandListExt)) {
+      *ppvObject = ref(&ext_);
+      return S_OK;
+    }
+
     if (logQueryInterfaceError(__uuidof(ID3D12GraphicsCommandList), riid)) {
       WARN("D3D12GraphicsCommandList: Unknown interface query ", str::format(riid));
     }
diff --git a/src/d3d12/d3d12_command_queue.cpp b/src/d3d12/d3d12_command_queue.cpp
index 57b0332..981ecdb 100644
--- a/src/d3d12/d3d12_command_queue.cpp
+++ b/src/d3d12/d3d12_command_queue.cpp
@@ -338,6 +338,29 @@ public:
 
           break;
         }
+        case EncoderType::TemporalUpscale: {
+          // MetalFX encodes its own passes; hand the queue's ordering to the scaler's fence and back.
+          auto data = static_cast<TemporalUpscaleEncoderData *>(current);
+          auto scaler_fence = data->scaler->fence();
+
+          auto begin = cmdbuf.blitCommandEncoder();
+          begin.setLabel(WMT::String::string("BeginScaler", WMTUTF8StringEncoding));
+          begin.waitForFence(fence_);
+          begin.updateFence(scaler_fence);
+          begin.endEncoding();
+
+          cmdbuf.encodeTemporalScale(
+              data->scaler->scaler(), data->input.texture(), data->output.texture(), data->depth.texture(),
+              data->motion_vector.texture(), data->exposure.texture(), scaler_fence, data->props
+          );
+
+          auto end = cmdbuf.blitCommandEncoder();
+          end.setLabel(WMT::String::string("EndScaler", WMTUTF8StringEncoding));
+          end.waitForFence(scaler_fence);
+          end.updateFence(fence_);
+          end.endEncoding();
+          break;
+        }
         }
         current = current->next;
       }
diff --git a/src/d3d12/d3d12_device.cpp b/src/d3d12/d3d12_device.cpp
index 039c106..ba352a3 100644
--- a/src/d3d12/d3d12_device.cpp
+++ b/src/d3d12/d3d12_device.cpp
@@ -48,6 +48,13 @@ class MTLD3D12DeviceImpl : public MTLD3D12Object<ComObject<MTLD3D12Device>> {
   FormatCapabilityInspector format_inspector_;
 
   D3D_FEATURE_LEVEL min_feature_level_;
+  struct CachedTemporalScaler {
+    WMTFXTemporalScalerInfo info;
+    TemporalScalerEntry entry;
+  };
+  dxmt::mutex scaler_lock_;
+  std::vector<CachedTemporalScaler> scaler_cache_;
+  WMT::Reference<WMT::ComputePipelineState> mv_downscale_pso_;
 
 public:
   MTLD3D12DeviceImpl(IMTLDXGIAdapter *adapter, D3D_FEATURE_LEVEL min_feature_level) :
@@ -1272,6 +1279,56 @@ public:
     return command_library;
   }
 
+  TemporalScalerEntry
+  GetTemporalScaler(const WMTFXTemporalScalerInfo &Info, bool MotionVectorInDisplayRes) {
+    std::lock_guard<dxmt::mutex> lock(scaler_lock_);
+    for (auto &cached : scaler_cache_) {
+      auto &i = cached.info;
+      if (i.color_format == Info.color_format && i.output_format == Info.output_format &&
+          i.depth_format == Info.depth_format && i.motion_format == Info.motion_format &&
+          i.input_width == Info.input_width && i.input_height == Info.input_height &&
+          i.output_width == Info.output_width && i.output_height == Info.output_height &&
+          i.auto_exposure == Info.auto_exposure &&
+          MotionVectorInDisplayRes == (cached.entry.motion_vector_lowres != nullptr))
+        return cached.entry;
+    }
+
+    CachedTemporalScaler cached{Info, {new TemporalScaler(GetMTLDevice(), Info), nullptr}};
+    if (MotionVectorInDisplayRes) {
+      WMTTextureInfo tex_info{};
+      tex_info.width = Info.input_width;
+      tex_info.height = Info.input_height;
+      tex_info.depth = 1;
+      tex_info.array_length = 1;
+      tex_info.mipmap_level_count = 1;
+      tex_info.pixel_format = Info.motion_format;
+      tex_info.sample_count = 1;
+      tex_info.type = WMTTextureType2D;
+      tex_info.usage = WMTTextureUsageShaderRead | WMTTextureUsageShaderWrite;
+      tex_info.options = WMTResourceStorageModePrivate;
+      auto texture = Rc<Texture>(new Texture(tex_info, GetMTLDevice()));
+      Flags<TextureAllocationFlag> flags;
+      flags.set(TextureAllocationFlag::GpuPrivate);
+      texture->rename(texture->allocate(flags));
+      cached.entry.motion_vector_lowres = std::move(texture);
+    }
+    scaler_cache_.push_back(cached);
+    return cached.entry;
+  }
+
+  WMT::ComputePipelineState
+  GetMotionVectorDownscalePipeline() {
+    std::lock_guard<dxmt::mutex> lock(scaler_lock_);
+    if (!mv_downscale_pso_) {
+      WMT::Reference<WMT::Error> err;
+      auto function = command_library.getLibrary().newFunction("cs_downscale_dilated_mv");
+      mv_downscale_pso_ = GetMTLDevice().newComputePipelineState(function, err);
+      if (!mv_downscale_pso_)
+        ERR("Failed to create the motion vector downscale pipeline: ", err.description().getUTF8String());
+    }
+    return mv_downscale_pso_;
+  }
+
   virtual FormatCapability
   GetMTLPixelFormatCapability(WMTPixelFormat Format) final {
     Format = ORIGINAL_FORMAT(Format);
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index 5da737a..f8a3bf0 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -189,6 +189,17 @@ public:
 
   virtual FormatCapability GetMTLPixelFormatCapability(WMTPixelFormat Format) = 0;
 
+  // MetalFX temporal scalers are costly to create, so they're kept per configuration for the device's
+  // lifetime. motion_vector_lowres is a render-size target for display-size motion vectors (null otherwise).
+  struct TemporalScalerEntry {
+    Rc<TemporalScaler> scaler;
+    Rc<Texture> motion_vector_lowres;
+  };
+  virtual TemporalScalerEntry GetTemporalScaler(const WMTFXTemporalScalerInfo &Info, bool MotionVectorInDisplayRes) = 0;
+
+  // Compute pipeline that turns display-size motion vectors into render-size ones (cs_downscale_dilated_mv).
+  virtual WMT::ComputePipelineState GetMotionVectorDownscalePipeline() = 0;
+
   EventListener event_listener;
 
   WMT::Reference<WMT::DepthStencilState> default_depth_stencil_state;
