@@ -0,0 +1,35 @@
+#pragma once
+#include "com/com_guid.hpp"
+#include "d3d12.h"
+
+/* D3D12 counterpart of MTL_TEMPORAL_UPSCALE_D3D11_DESC: one MetalFX temporal upscale, recorded into a command list. */
+struct MTL_TEMPORAL_UPSCALE_D3D12_DESC {
+  UINT InputContentWidth;  // can be 0, which means full width
+  UINT InputContentHeight; // can be 0, which means full height
+  BOOL AutoExposure;
+  BOOL InReset;
+  BOOL DepthReversed;
+  BOOL MotionVectorInDisplayRes;
+  ID3D12Resource *Color;
+  ID3D12Resource *Depth;
+  ID3D12Resource *MotionVector;
+  ID3D12Resource *Output;
+  FLOAT MotionVectorScaleX;
+  FLOAT MotionVectorScaleY;
+  FLOAT PreExposure;
+  ID3D12Resource *ExposureTexture;
+  FLOAT JitterOffsetX;
+  FLOAT JitterOffsetY;
+};
+
+typedef enum MTL_D3D12_FEATURE {
+  MTL_D3D12_FEATURE_METALFX_TEMPORAL_SCALER = 0,
+} MTL_D3D12_FEATURE;
+
+DEFINE_COM_INTERFACE("cd2dfaa3-e62d-4181-b333-27528b438fc5", IMTLD3D12CommandListExt) : public IUnknown {
+  // Returns FALSE when nothing was recorded (missing or unsupported resources).
+  virtual BOOL STDMETHODCALLTYPE TemporalUpscale(const MTL_TEMPORAL_UPSCALE_D3D12_DESC *pDesc) = 0;
+  virtual HRESULT STDMETHODCALLTYPE CheckFeatureSupport(
+      MTL_D3D12_FEATURE Feature, void *pFeatureSupportData, UINT FeatureSupportDataSize
+  ) = 0;
+};
