+NVNGX_API NVNGX_RESULT
+NVSDK_NGX_D3D12_EvaluateFeature_C(
+    ID3D12GraphicsCommandList *command_list, const unsigned int *handle, NVNGXParameter *params, void *callback
+) {
+  return NVSDK_NGX_D3D12_EvaluateFeature(command_list, handle, params, callback);
+}
