+/* Placement sparse resources (macOS 26.4+): resources without memory of their own, whose tiles are mapped to
+   pages of placement heaps through a Metal 4 command queue. The operation structs match Metal's on 64-bit. */
+
+enum WMTSparseMappingMode : uint64_t {
+  WMTSparseMappingModeMap = 0,
+  WMTSparseMappingModeUnmap = 1,
+};
+
+struct WMTSparseTextureMappingOperation {
+  enum WMTSparseMappingMode mode;
+  struct WMTOrigin origin; // in tiles
+  struct WMTSize size;     // in tiles
+  uint64_t level;
+  uint64_t slice;
+  uint64_t heap_offset; // in tiles
+};
+
+STATIC_ASSERT(sizeof(WMTSparseTextureMappingOperation) == 80);
+
+struct WMTSparseBufferMappingOperation {
+  enum WMTSparseMappingMode mode;
+  uint64_t location; // in tiles
+  uint64_t length;   // in tiles
+  uint64_t heap_offset; // in tiles
+};
+
+STATIC_ASSERT(sizeof(WMTSparseBufferMappingOperation) == 32);
