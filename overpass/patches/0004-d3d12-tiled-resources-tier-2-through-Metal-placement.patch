+  struct WMTOrigin src_origin; // in tiles
+  struct WMTSize src_size;     // in tiles
+  uint64_t src_level;
+  uint64_t src_slice;
+  struct WMTOrigin dst_origin; // in tiles
+  uint64_t dst_level;
+  uint64_t dst_slice;
+};
+
+STATIC_ASSERT(sizeof(WMTSparseTextureCopyOperation) == 104);
+
+struct WMTSparseBufferCopyOperation {
+  uint64_t src_location; // in tiles
+  uint64_t src_length;   // in tiles
+  uint64_t dst_location; // in tiles
+};
+
