+  // Work submitted before a mapping update sees the old mappings, work submitted after sees the new ones.
+  bool
+  BeginMappingUpdate() {
+    if (!mapping_queue_) {
+      auto metal_device = device_->GetMTLDevice();
+      mapping_queue_ = metal_device.newMTL4CommandQueue();
+      mapping_event_ = metal_device.newEvent();
+      if (!mapping_queue_ || !mapping_event_) {
+        ERR("UpdateTileMappings: no Metal 4 queue for tile mappings");
+        mapping_queue_ = {};
+        return false;
+      }
+    }
+    {
+      auto scope = StartCommitting();
+      scope.inflight.cmdbuf.encodeSignalEvent(mapping_event_, ++mapping_event_value_);
+    }
+    mapping_queue_.waitForEvent(mapping_event_, mapping_event_value_);
+    return true;
+  }
+
+  void
+  EndMappingUpdate() {
+    mapping_queue_.signalEvent(mapping_event_, ++mapping_event_value_);
+    auto scope = StartCommitting();
+    scope.inflight.cmdbuf.encodeWaitForEvent(mapping_event_, mapping_event_value_);
+  }
