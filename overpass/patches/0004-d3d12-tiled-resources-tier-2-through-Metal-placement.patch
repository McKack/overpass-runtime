   void STDMETHODCALLTYPE UpdateTileMappings(
       ID3D12Resource *resource, UINT region_count, const D3D12_TILED_RESOURCE_COORDINATE *region_start_coordinates,
       const D3D12_TILE_REGION_SIZE *region_sizes, ID3D12Heap *heap, UINT range_count,
       const D3D12_TILE_RANGE_FLAGS *range_flags, const UINT *heap_range_offsets, const UINT *range_tile_counts,
       D3D12_TILE_MAPPING_FLAGS flags
   ) {
-    IMPLEMENT_ME
+    auto res = static_cast<MTLD3D12Resource *>(resource);
+    if (!res || !res->tiling)
+      return;
+    auto &layout = *res->tiling;
+
+    // The resource's tiles, region after region. Without sizes a region is one tile, or the whole resource
+    // when there are no start coordinates either.
+    std::vector<uint32_t> tiles;
+    for (UINT i = 0; i < region_count; i++) {
+      D3D12_TILED_RESOURCE_COORDINATE start = region_start_coordinates ? region_start_coordinates[i]
+                                                                       : D3D12_TILED_RESOURCE_COORDINATE{};
+      D3D12_TILE_REGION_SIZE size{};
+      if (region_sizes)
+        size = region_sizes[i];
+      else
+        size.NumTiles = region_start_coordinates ? 1 : layout.total_tiles;
+      CollectRegionTiles(layout, start, size, tiles);
+    }
+
+    // Paired with heap tiles, range after range.
+    WMT::Heap metal_heap = heap ? WMT::Heap(static_cast<MTLD3D12Heap *>(heap)->heap) : WMT::Heap{};
+    std::vector<WMTSparseTextureMappingOperation> texture_ops;
+    std::vector<WMTSparseBufferMappingOperation> buffer_ops;
+    size_t next = 0;
+    for (UINT r = 0; r < range_count && next < tiles.size(); r++) {
+      auto range_flag = range_flags ? range_flags[r] : D3D12_TILE_RANGE_FLAG_NONE;
+      uint32_t offset = heap_range_offsets ? heap_range_offsets[r] : 0;
+      uint32_t count = range_tile_counts ? range_tile_counts[r] : uint32_t(tiles.size() - next);
+      for (uint32_t k = 0; k < count && next < tiles.size(); k++, next++) {
+        if (range_flag & D3D12_TILE_RANGE_FLAG_SKIP)
+          continue;
+        bool map = !(range_flag & D3D12_TILE_RANGE_FLAG_NULL);
+        if (map && !heap)
+          continue;
+        uint64_t heap_tile = (range_flag & D3D12_TILE_RANGE_FLAG_REUSE_SINGLE_TILE) ? offset : offset + k;
+        auto mode = map ? WMTSparseMappingModeMap : WMTSparseMappingModeUnmap;
+        TileRef tile = layout.TileAt(tiles[next]);
+
+        // Neighbouring tiles that take neighbouring heap tiles become one operation.
+        if (layout.is_buffer) {
+          if (!buffer_ops.empty()) {
+            auto &last = buffer_ops.back();
+            if (last.mode == mode && last.location + last.length == tile.x &&
+                (!map || last.heap_offset + last.length == heap_tile)) {
+              last.length++;
+              continue;
+            }
+          }
+          buffer_ops.push_back({mode, tile.x, 1, map ? heap_tile : 0});
+        } else {
+          if (!texture_ops.empty()) {
+            auto &last = texture_ops.back();
+            if (last.mode == mode && last.level == tile.level && last.slice == tile.slice &&
+                last.origin.y == tile.y && last.origin.z == tile.z && last.size.height == 1 &&
+                last.size.depth == 1 && last.origin.x + last.size.width == tile.x &&
+                (!map || last.heap_offset + last.size.width == heap_tile)) {
+              last.size.width++;
+              continue;
+            }
+          }
+          texture_ops.push_back({mode, {tile.x, tile.y, tile.z}, {1, 1, 1}, tile.level, tile.slice, map ? heap_tile : 0});
+        }
+      }
+    }
+    if (texture_ops.empty() && buffer_ops.empty())
+      return;
+
+    if (!BeginMappingUpdate())
+      return;
+    if (layout.is_buffer)
+      mapping_queue_.updateBufferMappings(res->buffer->current()->buffer(), metal_heap, buffer_ops.data(), buffer_ops.size());
+    else
+      mapping_queue_.updateTextureMappings(
+          res->texture->current()->texture(), metal_heap, texture_ops.data(), texture_ops.size()
+      );
+    EndMappingUpdate();
   };
 
