+        !src_region_start_coordinate || dst->tiling->is_buffer != src->tiling->is_buffer)
+      return;
+
+    std::vector<uint32_t> src_tiles, dst_tiles;
+    CollectRegionTiles(*src->tiling, *src_region_start_coordinate, *region_size, src_tiles);
+    CollectRegionTiles(*dst->tiling, *dst_region_start_coordinate, *region_size, dst_tiles);
+    size_t count = std::min(src_tiles.size(), dst_tiles.size());
+
+    std::vector<WMTSparseTextureCopyOperation> texture_ops;
+    std::vector<WMTSparseBufferCopyOperation> buffer_ops;
+    for (size_t i = 0; i < count; i++) {
+      TileRef s = src->tiling->TileAt(src_tiles[i]), d = dst->tiling->TileAt(dst_tiles[i]);
+      if (src->tiling->is_buffer) {
+        if (!buffer_ops.empty()) {
+          auto &last = buffer_ops.back();
+          if (last.src_location + last.src_length == s.x && last.dst_location + last.src_length == d.x) {
+            last.src_length++;
+            continue;
+          }
+        }
+        buffer_ops.push_back({s.x, 1, d.x});
+      } else {
+        if (s.packed != d.packed)
+          continue;
+        if (!texture_ops.empty()) {
+          auto &last = texture_ops.back();
+          if (last.src_level == s.level && last.src_slice == s.slice && last.dst_level == d.level &&
+              last.dst_slice == d.slice && last.src_origin.y == s.y && last.src_origin.z == s.z &&
+              last.dst_origin.y == d.y && last.dst_origin.z == d.z && last.src_size.height == 1 &&
+              last.src_size.depth == 1 && last.src_origin.x + last.src_size.width == s.x &&
+              last.dst_origin.x + last.src_size.width == d.x) {
+            last.src_size.width++;
+            continue;
+          }
+        }
+        texture_ops.push_back({{s.x, s.y, s.z}, {1, 1, 1}, s.level, s.slice, {d.x, d.y, d.z}, d.level, d.slice});
+      }
+    }
+    if (texture_ops.empty() && buffer_ops.empty())
+      return;
+
+    if (!BeginMappingUpdate())
+      return;
+    if (src->tiling->is_buffer)
+      mapping_queue_.copyBufferMappings(
+          src->buffer->current()->buffer(), dst->buffer->current()->buffer(), buffer_ops.data(), buffer_ops.size()
+      );
+    else
+      mapping_queue_.copyTextureMappings(
+          src->texture->current()->texture(), dst->texture->current()->texture(), texture_ops.data(),
+          texture_ops.size()
+      );
+    EndMappingUpdate();
   };
 
