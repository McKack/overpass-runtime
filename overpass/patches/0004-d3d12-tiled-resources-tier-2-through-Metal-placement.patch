+    MTLD3D12Device *pDevice, const D3D12_RESOURCE_DESC *pDesc, D3D12_RESOURCE_STATES InitialState,
+    const D3D12_CLEAR_VALUE *OptimizedClearValue, REFIID riid, void **ppResource
+) {
+  auto texture = Com(new MTLD3D12Texture(pDevice));
+  D3D12_HEAP_PROPERTIES heap_props = {D3D12_HEAP_TYPE_DEFAULT};
+  HRESULT hr = texture->Initialize(&heap_props, D3D12_HEAP_FLAG_NONE, pDesc, InitialState, nullptr, 0, true);
+  if (FAILED(hr))
+    return hr;
+  if (!ppResource)
+    return S_FALSE;
+  return texture->QueryInterface(riid, ppResource);
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_tiling.cpp b/src/d3d12/d3d12_tiling.cpp
new file mode 100644
index 0000000..971a6eb
--- /dev/null
+++ b/src/d3d12/d3d12_tiling.cpp
@@ -0,0 +1,167 @@
+#include "d3d12_tiling.hpp"
+#include <algorithm>
+
+namespace dxmt {
+
+static uint32_t
+div_up(uint64_t value, uint64_t divisor) {
+  return uint32_t((value + divisor - 1) / divisor);
+}
+
+TileLayout
+TileLayout::ForBuffer(uint64_t width) {
+  TileLayout layout;
+  layout.is_buffer = true;
+  layout.shape = {kTileSizeInBytes, 1, 1};
+  layout.total_tiles = layout.tiles_per_slice = div_up(width, kTileSizeInBytes);
+  layout.mips.push_back({layout.total_tiles, 1, 1, 0});
+  return layout;
+}
+
+bool
+TileLayout::ForTexture(
+    WMT::Device device, const D3D12_RESOURCE_DESC &desc, const WMTTextureInfo &info, WMT::Texture texture,
+    TileLayout &out
+) {
+  TileLayout layout;
+  uint64_t tile_bytes = 0;
+  auto tile = device.sparseTileSize(info.type, info.pixel_format, info.sample_count, WMTSparsePageSize64, &tile_bytes);
+  if (tile_bytes != kTileSizeInBytes || !tile.width || !tile.height || !tile.depth)
+    return false;
+  layout.shape = {uint32_t(tile.width), uint32_t(tile.height), uint32_t(tile.depth)};
+  layout.mip_levels = info.mipmap_level_count;
+  layout.array_size = desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D ? 1 : desc.DepthOrArraySize;
+
+  auto [first_tail_level, tail_bytes] = texture.sparseTail();
+  layout.standard_mips = std::min<uint32_t>(first_tail_level, layout.mip_levels);
+  layout.packed_tiles = layout.standard_mips < layout.mip_levels ? div_up(tail_bytes, kTileSizeInBytes) : 0;
+
+  uint32_t start = 0;
+  for (uint32_t level = 0; level < layout.standard_mips; level++) {
+    uint32_t width = std::max<uint32_t>(1, info.width >> level);
+    uint32_t height = std::max<uint32_t>(1, info.height >> level);
+    uint32_t depth = std::max<uint32_t>(1, info.depth >> level);
+    D3D12_SUBRESOURCE_TILING mip = {
+        div_up(width, layout.shape.WidthInTexels), uint16_t(div_up(height, layout.shape.HeightInTexels)),
+        uint16_t(div_up(depth, layout.shape.DepthInTexels)), start
+    };
+    start += mip.WidthInTiles * mip.HeightInTiles * mip.DepthInTiles;
+    layout.mips.push_back(mip);
+  }
+  layout.tiles_per_slice = start + layout.packed_tiles;
+  layout.total_tiles = layout.tiles_per_slice * layout.array_size;
+  out = std::move(layout);
+  return true;
+}
+
+uint32_t
+TileLayout::SubresourceStart(uint32_t subresource) const {
+  if (is_buffer)
+    return 0;
+  uint32_t level = subresource % mip_levels, slice = subresource / mip_levels;
+  uint32_t base = slice * tiles_per_slice;
+  if (level >= standard_mips)
+    return base + tiles_per_slice - packed_tiles;
+  return base + mips[level].StartTileIndexInOverallResource;
+}
+
+uint32_t
+TileLayout::IndexOf(const D3D12_TILED_RESOURCE_COORDINATE &coord) const {
+  if (coord.Subresource >= SubresourceCount())
+    return UINT32_MAX;
+  if (is_buffer)
+    return coord.X < total_tiles ? coord.X : UINT32_MAX;
+  uint32_t level = coord.Subresource % mip_levels;
+  if (level >= standard_mips)
+    return coord.X < packed_tiles ? SubresourceStart(coord.Subresource) + coord.X : UINT32_MAX;
+  auto &mip = mips[level];
+  if (coord.X >= mip.WidthInTiles || coord.Y >= mip.HeightInTiles || coord.Z >= mip.DepthInTiles)
+    return UINT32_MAX;
+  return SubresourceStart(coord.Subresource) + (coord.Z * mip.HeightInTiles + coord.Y) * mip.WidthInTiles + coord.X;
+}
+
+TileRef
+TileLayout::TileAt(uint32_t index) const {
+  TileRef tile{};
+  if (is_buffer) {
+    tile.x = index;
+    return tile;
+  }
+  tile.slice = index / tiles_per_slice;
+  uint32_t in_slice = index % tiles_per_slice;
+  for (uint32_t level = 0; level < standard_mips; level++) {
+    auto &mip = mips[level];
+    uint32_t count = mip.WidthInTiles * mip.HeightInTiles * mip.DepthInTiles;
+    if (in_slice < mip.StartTileIndexInOverallResource + count) {
+      uint32_t local = in_slice - mip.StartTileIndexInOverallResource;
+      tile.level = level;
+      tile.x = local % mip.WidthInTiles;
+      tile.y = (local / mip.WidthInTiles) % mip.HeightInTiles;
+      tile.z = local / (mip.WidthInTiles * mip.HeightInTiles);
+      return tile;
+    }
+  }
+  tile.packed = true;
+  tile.level = standard_mips;
+  tile.x = in_slice - (tiles_per_slice - packed_tiles);
+  return tile;
+}
+
+void
+TileLayout::GetResourceTiling(
+    UINT *pTotalTileCount, D3D12_PACKED_MIP_INFO *pPackedMipInfo, D3D12_TILE_SHAPE *pStandardTileShape,
+    UINT *pSubresourceTilingCount, UINT FirstSubresourceTiling, D3D12_SUBRESOURCE_TILING *pSubresourceTilings
+) const {
+  if (pTotalTileCount)
+    *pTotalTileCount = total_tiles;
+  if (pPackedMipInfo) {
+    pPackedMipInfo->NumStandardMips = is_buffer ? 0 : standard_mips;
+    pPackedMipInfo->NumPackedMips = is_buffer ? 0 : mip_levels - standard_mips;
+    pPackedMipInfo->NumTilesForPackedMips = packed_tiles;
+    pPackedMipInfo->StartTileIndexInOverallResource = packed_tiles ? tiles_per_slice - packed_tiles : 0;
+  }
+  if (pStandardTileShape)
+    *pStandardTileShape = shape;
+  if (pSubresourceTilingCount) {
+    uint32_t count = SubresourceCount();
+    uint32_t first = std::min(FirstSubresourceTiling, count);
+    uint32_t written = std::min(*pSubresourceTilingCount, count - first);
+    for (uint32_t i = 0; pSubresourceTilings && i < written; i++) {
+      uint32_t subresource = first + i;
+      uint32_t level = is_buffer ? 0 : subresource % mip_levels;
+      if (!is_buffer && level >= standard_mips) {
+        pSubresourceTilings[i] = {0, 0, 0, D3D12_PACKED_TILE};
+      } else {
+        pSubresourceTilings[i] = mips[level];
+        pSubresourceTilings[i].StartTileIndexInOverallResource = SubresourceStart(subresource);
+      }
+    }
+    *pSubresourceTilingCount = written;
+  }
+}
+
+void
+CollectRegionTiles(
+    const TileLayout &layout, const D3D12_TILED_RESOURCE_COORDINATE &start, const D3D12_TILE_REGION_SIZE &size,
+    std::vector<uint32_t> &out
+) {
+  if (!size.UseBox) {
+    uint32_t first = layout.IndexOf(start);
+    if (first == UINT32_MAX)
+      return;
+    uint32_t count = std::min<uint32_t>(size.NumTiles, layout.total_tiles - first);
+    for (uint32_t i = 0; i < count; i++)
+      out.push_back(first + i);
+    return;
+  }
+  for (uint32_t z = 0; z < size.Depth; z++)
+    for (uint32_t y = 0; y < size.Height; y++)
+      for (uint32_t x = 0; x < size.Width; x++) {
+        D3D12_TILED_RESOURCE_COORDINATE coord = {start.X + x, start.Y + y, start.Z + z, start.Subresource};
+        uint32_t index = layout.IndexOf(coord);
+        if (index != UINT32_MAX)
+          out.push_back(index);
+      }
+}
+
+} // namespace dxmt
diff --git a/src/d3d12/d3d12_tiling.hpp b/src/d3d12/d3d12_tiling.hpp
new file mode 100644
index 0000000..2eb48bf
--- /dev/null
+++ b/src/d3d12/d3d12_tiling.hpp
@@ -0,0 +1,67 @@
+#pragma once
+
+#include "d3d12.h"
+#include "Metal.hpp"
+#include <cstdint>
+#include <vector>
+
+namespace dxmt {
+
+/* Tiled (reserved) resources use D3D12's 64 KB tiles, backed by Metal placement sparse pages of the same size.
+
+   D3D12 numbers a resource's tiles in one sequence: for each array slice, the tiles of each regular mip level
+   in X, Y, Z order, then that slice's packed mip tiles. TileLayout describes that sequence and converts between
+   an index in it and a tile Metal understands. */
+
+constexpr uint32_t kTileSizeInBytes = D3D12_TILED_RESOURCE_TILE_SIZE_IN_BYTES;
+
+struct TileRef {
+  uint32_t level;  // for packed tiles: the first packed mip
+  uint32_t slice;
+  uint32_t x, y, z; // for packed tiles: x is the index in the slice's packed tiles
+  bool packed;
+};
+
+class TileLayout {
+public:
+  bool is_buffer = false;
+  D3D12_TILE_SHAPE shape{};    // texels per tile; for buffers 64 KB x 1 x 1 bytes
+  uint32_t mip_levels = 1;
+  uint32_t array_size = 1;
+  uint32_t standard_mips = 1;  // mips before the packed tail
+  uint32_t packed_tiles = 0;   // per slice
+  uint32_t tiles_per_slice = 0;
+  uint32_t total_tiles = 0;
+  std::vector<D3D12_SUBRESOURCE_TILING> mips; // per standard mip, StartTileIndexInOverallResource relative to the slice
+
+  // Buffers: tiles of `width` bytes.
+  static TileLayout ForBuffer(uint64_t width);
+
+  // Textures: needs the created placement sparse texture for its packed mip tail.
+  static bool ForTexture(WMT::Device device, const D3D12_RESOURCE_DESC &desc, const WMTTextureInfo &info,
+                         WMT::Texture texture, TileLayout &out);
+
+  uint32_t SubresourceCount() const { return is_buffer ? 1 : mip_levels * array_size; }
+
+  // Index of a subresource's first tile, or of a packed subresource's slice tail.
+  uint32_t SubresourceStart(uint32_t subresource) const;
+
+  // Index of a tile given by D3D12 coordinates, or UINT32_MAX when out of range.
+  uint32_t IndexOf(const D3D12_TILED_RESOURCE_COORDINATE &coord) const;
+
+  TileRef TileAt(uint32_t index) const;
+
+  void GetResourceTiling(
+      UINT *pTotalTileCount, D3D12_PACKED_MIP_INFO *pPackedMipInfo, D3D12_TILE_SHAPE *pStandardTileShape,
+      UINT *pSubresourceTilingCount, UINT FirstSubresourceTiling, D3D12_SUBRESOURCE_TILING *pSubresourceTilings
+  ) const;
+};
+
+// The tile indices a D3D12 region covers, in order. A region without a box runs on through later subresources.
+void
+CollectRegionTiles(
+    const TileLayout &layout, const D3D12_TILED_RESOURCE_COORDINATE &start, const D3D12_TILE_REGION_SIZE &size,
+    std::vector<uint32_t> &out
+);
+
+} // namespace dxmt
