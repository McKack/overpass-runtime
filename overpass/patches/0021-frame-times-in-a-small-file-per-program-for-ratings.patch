--- /dev/null
+++ b/src/dxmt/dxmt_frame_log.hpp
@@ -0,0 +1,88 @@
+#pragma once
+
+// Frame times of a run, for OverPass's ratings: one small text file per program, rewritten every few seconds so it
+// survives however the game ends. Gaps of a second or more (loading, the game in the background) don't count.
+
+#include <windows.h>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+
+namespace dxmt {
+
+class FrameLog {
+public:
+  static FrameLog &
+  instance() {
+    static FrameLog log;
+    return log;
+  }
+
+  void
+  present() {
+    auto now = clock::now();
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (last_ != clock::time_point{}) {
+      double ms = std::chrono::duration<double, std::milli>(now - last_).count();
+      if (ms < kGap) {
+        if (frames_)
+          jitter_ += std::fabs(ms - previous_);
+        previous_ = ms;
+        total_ += ms;
+        frames_ += 1;
+        buckets_[static_cast<size_t>(ms * kPerMillisecond)] += 1;
+      }
+    }
+    last_ = now;
+    if (frames_ && now - written_ >= std::chrono::seconds(5)) {
+      written_ = now;
+      write();
+    }
+  }
+
+private:
+  using clock = std::chrono::steady_clock;
+  static constexpr double kGap = 1000;
+  static constexpr double kPerMillisecond = 2;
+
+  void
+  write() {
+    uint64_t seen = 0, slowest = frames_ / 100;
+    size_t bucket = buckets_.size();
+    while (bucket > 0 && seen <= slowest)
+      seen += buckets_[--bucket];
+    double p99 = (bucket + 1) / kPerMillisecond;
+
+    char text[128];
+    int size = snprintf(text, sizeof(text), "fps=%.1f low=%.1f ms=%.1f p99=%.1f jitter=%.1f seconds=%.0f\n",
+                        frames_ * 1000.0 / total_, 1000.0 / p99, total_ / frames_, p99, jitter_ / frames_, total_ / 1000.0);
+
+    wchar_t program[MAX_PATH], path[MAX_PATH + 64];
+    if (!GetModuleFileNameW(nullptr, program, MAX_PATH))
+      return;
+    wchar_t *name = wcsrchr(program, L'\\');
+    name = name ? name + 1 : program;
+    if (wchar_t *dot = wcsrchr(name, L'.'))
+      *dot = 0;
+    CreateDirectoryW(L"C:\\users\\Public\\OverPass", nullptr);
+    CreateDirectoryW(L"C:\\users\\Public\\OverPass\\Frames", nullptr);
+    _snwprintf(path, MAX_PATH + 64, L"C:\\users\\Public\\OverPass\\Frames\\%ls.txt", name);
+    HANDLE file = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+      return;
+    DWORD written;
+    WriteFile(file, text, size, &written, nullptr);
+    CloseHandle(file);
+  }
+
+  std::mutex mutex_;
+  clock::time_point last_{}, written_ = clock::now();
+  double previous_ = 0, total_ = 0, jitter_ = 0;
+  uint64_t frames_ = 0;
+  std::array<uint32_t, 2000> buckets_{};
+};
+
+} // namespace dxmt
