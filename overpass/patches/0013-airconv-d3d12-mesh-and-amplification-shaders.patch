+
+// DXIL mesh shaders (Metal mesh functions) and amplification shaders (Metal object functions).
+
+#include "dxil_converter_base.hpp"
+
+#include "../airconv_error.hpp"
+#include "../dxbc_converter.hpp"
+#include "dxil_constants.hpp"
+
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DerivedTypes.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Module.h"
+
+using namespace llvm;
+using namespace llvm::air;
+
+namespace dxmt::dxil {
+
+llvm::Error unsupported(llvm::StringRef what);
+std::optional<uint32_t> asU32(Value *value);
+
+static bool
+IsDxilOp(const Instruction &Inst, StringRef Name) {
+  auto *Call = dyn_cast<CallInst>(&Inst);
+  if (!Call || !Call->getCalledFunction())
+    return false;
+  auto Callee = Call->getCalledFunction()->getName();
+  return Callee.startswith("dx.op.") && Callee.drop_front(strlen("dx.op.")).startswith(Name);
+}
+
+llvm::Error
+Converter::InitializeMesh() {
+  mesh_state_ = find_mesh_state(entry);
+  amplification_state_ = find_amplification_state(entry);
+  if (!mesh_state_)
+    return llvm::Error::success();
+  auto Layout = build_mesh_output_layout(entry);
+  if (!Layout)
+    return Layout.takeError();
+  mesh_layout_ = std::move(*Layout);
+
+  // Group the output stores of each block by row and vertex/primitive index.
+  for (auto &BB : *entry.function) {
+    std::map<std::tuple<bool, uint32_t, uint32_t, const Value *>, SmallVector<const CallInst *, 4>> Groups;
+    for (auto &Inst : BB) {
+      bool Vertex = IsDxilOp(Inst, "storeVertexOutput"), Primitive = IsDxilOp(Inst, "storePrimitiveOutput");
+      if (!Vertex && !Primitive)
+        continue;
+      auto *Call = cast<CallInst>(&Inst);
+      auto SigId = asU32(Call->getArgOperand(1)), Row = asU32(Call->getArgOperand(2));
+      if (!SigId || !Row)
+        return unsupported("dxil: non-constant mesh output row");
+      Groups[{Primitive, *SigId, *Row, Call->getArgOperand(5)}].push_back(Call);
+    }
+    for (auto &[Key, Calls] : Groups) {
+      auto *Row = mesh_layout_.find(std::get<0>(Key), std::get<1>(Key), std::get<2>(Key));
+      if (!Row)
+        return unsupported("dxil: mesh output row not in the signature");
+      uint32_t Covered = 0;
+      for (auto *Call : Calls)
+        if (auto Col = asU32(Call->getArgOperand(3)))
+          Covered |= 1u << *Col;
+      uint32_t Needed = (1u << Row->cols) - 1;
+      if ((Covered & Needed) != Needed)
+        continue; // partial row: each store goes through the threadgroup copy
+      for (auto *Call : Calls)
+        mesh_store_deferred_.insert(Call);
+      mesh_store_deferred_.erase(Calls.back());
+      mesh_store_groups_[Calls.back()] = Calls;
+    }
+  }
+  return llvm::Error::success();
+}
+
+llvm::Value *
+Converter::GetPayloadArgument() {
+  for (auto &Arg : ir.GetInsertBlock()->getParent()->args())
+    if (auto *Ty = dyn_cast<PointerType>(Arg.getType()))
+      if (Ty->getAddressSpace() == (unsigned)dxmt::air::AddressSpace::object_data)
+        return &Arg;
+  return nullptr;
+}
+
+llvm::Type *
+Converter::MeshRowType(const MeshOutputRow &Row) {
+  if (Row.kind == SemanticKind::Position)
+    return FixedVectorType::get(ir.getFloatTy(), 4);
+  return dxmt::air::get_llvm_type(Row.type, air.getContext());
+}
+
+// Writes a row's components (column, value) for one vertex or primitive.
+llvm::Error
+Converter::EmitMeshRow(
+    const MeshOutputRow &Row, bool Primitive, Value *Index, ArrayRef<std::pair<uint32_t, Value *>> Components
+) {
+  auto RowValue = [&]() -> Value * {
+    auto *Ty = cast<FixedVectorType>(MeshRowType(Row));
+    Value *Vec = UndefValue::get(Ty);
+    for (auto [Col, V] : Components)
+      Vec = ir.CreateInsertElement(Vec, BitcastIfNeeded(V, Ty->getElementType()), Row.start_col + Col);
+    return Vec;
+  };
+  auto Scalar = [&]() -> Value * { return Components.back().second; };
+
+  if (Row.data_index >= 0) {
+    if (Primitive)
+      air.CreateSetMeshPrimitiveData(Index, ir.getInt32(Row.data_index), RowValue());
+    else
+      air.CreateSetMeshVertexData(Index, ir.getInt32(Row.data_index), RowValue());
+  }
+  switch (Row.kind) {
+  case SemanticKind::Position:
+    air.CreateSetMeshPosition(Index, RowValue());
+    break;
+  case SemanticKind::ClipDistance:
+    for (auto [Col, V] : Components)
+      air.CreateSetMeshClipDistance(Index, ir.getInt32(Row.clip_base + Col), BitcastIfNeeded(V, ir.getFloatTy()));
+    break;
+  case SemanticKind::RenderTargetArrayIndex:
+    air.CreateSetMeshRenderTargetArrayIndex(Index, ir.CreateZExtOrTrunc(Scalar(), ir.getInt32Ty()));
+    break;
+  case SemanticKind::ViewPortArrayIndex:
+    air.CreateSetMeshViewportArrayIndex(Index, ir.CreateZExtOrTrunc(Scalar(), ir.getInt32Ty()));
+    break;
+  case SemanticKind::CullPrimitive: {
+    auto *V = Scalar();
+    if (!V->getType()->isIntegerTy(1))
+      V = ir.CreateICmpNE(V, Constant::getNullValue(V->getType()));
+    air.CreateSetMeshPrimitiveCulled(Index, V);
+    break;
+  }
+  default:
+    break;
+  }
+  return llvm::Error::success();
+}
+
+llvm::Expected<llvm::Value *>
+Converter::EmitMeshOutputStore(const CallInst &Call, bool Primitive) {
+  if (!mesh_state_)
+    return unsupported("dxil: mesh output outside a mesh shader");
+  if (mesh_store_deferred_.contains(&Call))
+    return (Value *)nullptr;
+  auto SigId = asU32(Call.getArgOperand(1)), Row = asU32(Call.getArgOperand(2));
+  auto *Layout = mesh_layout_.find(Primitive, *SigId, *Row);
+  auto Index = Get(Call.getArgOperand(5));
+  if (!Index)
+    return Index.takeError();
+
+  auto Group = mesh_store_groups_.find(&Call);
+  if (Group != mesh_store_groups_.end()) {
+    SmallVector<std::pair<uint32_t, Value *>, 4> Components;
+    for (auto *Store : Group->second) {
+      auto Col = asU32(Store->getArgOperand(3));
+      if (!Col)
+        return unsupported("dxil: non-constant mesh output column");
+      auto V = Get(Store->getArgOperand(4));
+      if (!V)
+        return V.takeError();
+      Components.push_back({*Col, *V});
+    }
+    if (auto err = EmitMeshRow(*Layout, Primitive, *Index, Components))
+      return std::move(err);
+    return (Value *)nullptr;
+  }
+
+  // Partial row: keep the row in threadgroup memory and write all of it each time.
+  auto Col = asU32(Call.getArgOperand(3));
+  if (!Col)
+    return unsupported("dxil: non-constant mesh output column");
+  auto V = Get(Call.getArgOperand(4));
+  if (!V)
+    return V.takeError();
+  auto *RowTy = cast<FixedVectorType>(MeshRowType(*Layout));
+  auto &Shadow = mesh_shadow_rows_[{Primitive, *SigId, *Row}];
+  if (!Shadow) {
+    auto *Ty = ArrayType::get(RowTy, Primitive ? mesh_state_->max_primitives : mesh_state_->max_vertices);
+    Shadow = new GlobalVariable(
+        *air.getModule(), Ty, false, GlobalValue::InternalLinkage, UndefValue::get(Ty), "mesh_output_row", nullptr,
+        GlobalValue::NotThreadLocal, 3
+    );
+    Shadow->setAlignment(Align(16));
+  }
+  auto *Slot = ir.CreateGEP(Shadow->getValueType(), Shadow, {ir.getInt32(0), *Index});
+  auto *Elem = ir.CreateGEP(
+      RowTy->getElementType(), ir.CreateBitCast(Slot, RowTy->getElementType()->getPointerTo(3)),
+      {ir.getInt32(Layout->start_col + *Col)}
+  );
+  ir.CreateStore(BitcastIfNeeded(*V, RowTy->getElementType()), Elem);
+  Value *Whole = ir.CreateLoad(RowTy, Slot);
+  SmallVector<std::pair<uint32_t, Value *>, 4> Components;
+  for (uint32_t C = 0; C < Layout->cols; C++)
+    Components.push_back({C, ir.CreateExtractElement(Whole, Layout->start_col + C)});
+  if (auto err = EmitMeshRow(*Layout, Primitive, *Index, Components))
+    return std::move(err);
+  return (Value *)nullptr;
+}
+
+llvm::Expected<llvm::Value *>
+Converter::EmitSetMeshOutputCounts(const CallInst &Call) {
+  // Every thread calls it with the same counts; Metal only needs the primitive count.
+  auto Primitives = Get(Call.getArgOperand(2));
+  if (!Primitives)
+    return Primitives.takeError();
+  air.CreateSetMeshPrimitiveCount(*Primitives);
+  return (Value *)nullptr;
+}
+
+llvm::Expected<llvm::Value *>
+Converter::EmitEmitIndices(const CallInst &Call) {
+  if (!mesh_state_)
+    return unsupported("dxil: emitIndices outside a mesh shader");
+  unsigned PerPrimitive = mesh_state_->topology == 1 ? 2 : mesh_state_->topology == 2 ? 3 : 1;
+  auto Primitive = Get(Call.getArgOperand(1));
+  if (!Primitive)
+    return Primitive.takeError();
+  auto *First = ir.CreateMul(*Primitive, ir.getInt32(PerPrimitive));
+  for (unsigned i = 0; i < PerPrimitive; i++) {
+    auto Vertex = Get(Call.getArgOperand(2 + i));
+    if (!Vertex)
+      return Vertex.takeError();
+    air.CreateSetMeshIndex(ir.CreateAdd(First, ir.getInt32(i)), *Vertex);
+  }
+  return (Value *)nullptr;
+}
+
+llvm::Expected<llvm::Value *>
+Converter::EmitGetMeshPayload(const CallInst &Call) {
+  auto *Payload = GetPayloadArgument();
+  if (!Payload)
+    return unsupported("dxil: mesh payload without an amplification payload");
+  auto *Ty = cast<PointerType>(Call.getType());
+  return ir.CreateBitCast(
+      Payload, MapType(Ty->getNonOpaquePointerElementType())->getPointerTo(Payload->getType()->getPointerAddressSpace())
+  );
+}
+
+// All threads call DispatchMesh once, at the end. The groupshared payload is copied to the object's payload by all
+// threads together, then one thread sets the mesh grid.
+llvm::Expected<llvm::Value *>
+Converter::EmitDispatchMesh(const CallInst &Call) {
+  if (!amplification_state_)
+    return unsupported("dxil: dispatchMesh outside an amplification shader");
+  Value *Counts[3];
+  for (unsigned i = 0; i < 3; i++) {
+    auto V = Get(Call.getArgOperand(1 + i));
+    if (!V)
+      return V.takeError();
+    Counts[i] = *V;
+  }
+  auto Source = Get(Call.getArgOperand(4));
+  if (!Source)
+    return Source.takeError();
+  auto *Payload = GetPayloadArgument();
+  if (!Payload)
+    return unsupported("dxil: amplification shader without a payload");
+
+  air.CreateBarrier(MemFlags::Threadgroup);
+  auto *Lid = air.CreateGetLocalLinearID();
+  auto &N = amplification_state_->num_threads;
+  uint32_t Threads = N.x * N.y * N.z, Words = amplification_state_->payload_size / 4;
+  auto *From = ir.CreateBitCast(*Source, ir.getInt32Ty()->getPointerTo(3));
+  auto *To = ir.CreateBitCast(Payload, ir.getInt32Ty()->getPointerTo(Payload->getType()->getPointerAddressSpace()));
+  auto *Fn = ir.GetInsertBlock()->getParent();
+  for (uint32_t Base = 0; Base < Words; Base += Threads) {
+    auto *I = ir.CreateAdd(Lid, ir.getInt32(Base));
+    auto *CopyBB = BasicBlock::Create(air.getContext(), "payload.copy", Fn);
+    auto *NextBB = BasicBlock::Create(air.getContext(), "payload.next", Fn);
+    ir.CreateCondBr(ir.CreateICmpULT(I, ir.getInt32(Words)), CopyBB, NextBB);
+    ir.SetInsertPoint(CopyBB);
+    ir.CreateStore(ir.CreateLoad(ir.getInt32Ty(), ir.CreateGEP(ir.getInt32Ty(), From, {I})),
+                   ir.CreateGEP(ir.getInt32Ty(), To, {I}));
+    ir.CreateBr(NextBB);
+    ir.SetInsertPoint(NextBB);
