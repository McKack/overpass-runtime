+const MeshState *
+find_mesh_state(const EntryPoint &entry) {
+  for (auto &property : entry.properties)
+    if (property.tag == EntryPropertyTag::MSState)
+      return &property.mesh_state;
+  return nullptr;
+}
+
+const AmplificationState *
+find_amplification_state(const EntryPoint &entry) {
+  for (auto &property : entry.properties)
+    if (property.tag == EntryPropertyTag::ASState)
+      return &property.amplification_state;
+  return nullptr;
+}
+
+llvm::Expected<MeshOutputLayout>
+build_mesh_output_layout(const EntryPoint &entry) {
+  MeshOutputLayout layout;
+  int32_t vertex_data = 0, primitive_data = 0;
+  for (bool primitive : {false, true}) {
+    auto &elements = primitive ? entry.primitive_outputs : entry.outputs;
+    for (auto &element : elements) {
+      auto msl_type = to_signature_msl_type(element.component_type);
+      for (unsigned row = 0; row < element.rows; row++) {
+        MeshOutputRow out;
+        out.sig_id = element.id;
+        out.row = row;
+        out.kind = element.semantic_kind;
+        out.start_col = element.start_col < 0 ? 0 : element.start_col;
+        out.cols = element.cols;
+        switch (element.semantic_kind) {
+        case SemanticKind::Arbitrary:
+        case SemanticKind::ClipDistance:
+        case SemanticKind::CullDistance: {
+          if (!msl_type)
+            return unsupported("dxil: unsupported mesh shader output component type");
+          auto user = element_attribute_name(element, row);
+          if (!user)
+            return user.takeError();
+          out.user = *user;
+          out.type = *msl_type;
+          out.data_index = primitive ? primitive_data++ : vertex_data++;
+          if (element.semantic_kind == SemanticKind::ClipDistance) {
+            out.clip_base = layout.clip_count;
+            layout.clip_count += element.cols;
+          }
+          break;
+        }
+        case SemanticKind::Position:
+        case SemanticKind::RenderTargetArrayIndex:
+        case SemanticKind::ViewPortArrayIndex:
+        case SemanticKind::CullPrimitive:
+        case SemanticKind::PrimitiveID: // Metal's primitive_id is the primitive's index in the mesh; not written
+        case SemanticKind::ShadingRate: // no variable rate shading
+          break;
+        default:
+          return unsupported(
+              "dxil: unsupported mesh shader output semantic " + std::to_string((uint32_t)element.semantic_kind)
+          );
+        }
+        (primitive ? layout.primitive : layout.vertex).push_back(std::move(out));
+      }
+    }
+  }
+  return layout;
+}
+
+// Mesh shader outputs are written by the converter (storeVertexOutput, storePrimitiveOutput); here they're only
+// declared on the Metal mesh.
+llvm::Error
+initialize_mesh_signature(dxmt::dxbc::SM50ShaderInternal *shader) {
+  auto layout = build_mesh_output_layout(shader->dxil_entry);
+  if (!layout)
+    return layout.takeError();
+  shader->signature_handlers.push_back([layout = *layout](dxbc::SignatureContext &ctx) {
+    for (auto &out : layout.vertex) {
+      if (out.data_index >= 0)
+        ctx.func_signature.DefineMeshVertexOutput(
+            air::OutputMeshData{.user = out.user, .type = out.type, .index = (uint32_t)out.data_index}
+        );
+      if (out.kind == SemanticKind::Position)
+        ctx.func_signature.DefineMeshVertexOutput(air::OutputPosition{.type = air::msl_float4});
+    }
+    if (layout.clip_count)
+      ctx.func_signature.DefineMeshVertexOutput(air::OutputClipDistance{.count = layout.clip_count});
+    for (auto &out : layout.primitive) {
+      if (out.data_index >= 0)
+        ctx.func_signature.DefineMeshPrimitiveOutput(
+            air::OutputMeshData{.user = out.user, .type = out.type, .index = (uint32_t)out.data_index}
+        );
+      if (out.kind == SemanticKind::RenderTargetArrayIndex)
+        ctx.func_signature.DefineMeshPrimitiveOutput(air::OutputRenderTargetArrayIndex{});
+      if (out.kind == SemanticKind::ViewPortArrayIndex)
+        ctx.func_signature.DefineMeshPrimitiveOutput(air::OutputViewportArrayIndex{});
+      if (out.kind == SemanticKind::CullPrimitive)
+        ctx.func_signature.DefineMeshPrimitiveOutput(air::OutputPrimitiveCulled{});
+    }
+  });
+  return llvm::Error::success();
+}
