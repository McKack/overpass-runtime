--- a/src/airconv/dxil_metadata.cpp
+++ b/src/airconv/dxil_metadata.cpp
@@ -252,6 +252,27 @@ parse_property(EntryPropertyTag tag, MetadataReader r) {
     property.num_threads = *num_threads;
     break;
   }
+  case EntryPropertyTag::MSState: {
+    auto num_threads = parse_num_threads(r.operand(0));
+    if (!num_threads)
+      return num_threads.takeError();
+    auto rest = r.slice(1, 4).asTuple<uint32_t, uint32_t, uint32_t, uint32_t>();
+    if (!rest)
+      return rest.takeError();
+    property.mesh_state = MeshState{*num_threads, std::get<0>(*rest), std::get<1>(*rest), std::get<2>(*rest),
+                                    std::get<3>(*rest)};
+    break;
+  }
+  case EntryPropertyTag::ASState: {
+    auto num_threads = parse_num_threads(r.operand(0));
+    if (!num_threads)
+      return num_threads.takeError();
+    auto payload = r.operand(1).asUint();
+    if (!payload)
+      return payload.takeError();
+    property.amplification_state = AmplificationState{*num_threads, *payload};
+    break;
+  }
   default:
