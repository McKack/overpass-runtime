   } else {
     return llvm::make_error<UnsupportedFeature>("dxil: unsupported shader stage " + std::string(stage));
   }
@@ -940,6 +1061,20 @@ initialize(
       pRefl->ThreadgroupSize[1] = shader->threadgroup_size[1];
