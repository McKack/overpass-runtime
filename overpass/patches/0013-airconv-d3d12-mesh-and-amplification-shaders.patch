diff --git a/src/airconv/dxil_mesh.hpp b/src/airconv/dxil_mesh.hpp
new file mode 100644
index 0000000..0aba3c5
--- /dev/null
+++ b/src/airconv/dxil_mesh.hpp
@@ -0,0 +1,52 @@
+/*
+ * This file is part of OverPass Runtime's additions to DXMT.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#pragma once
+
+#include "air_signature.hpp"
+#include "dxil_metadata.hpp"
+
+#include <vector>
+
+namespace dxmt::dxil {
+
+// Where a mesh shader output row (signature element + row) goes in the Metal mesh: a user data field (a 4-wide
+// vector of the element's type, components at their register columns, like vertex shader outputs) and/or a
+// builtin.
+struct MeshOutputRow {
+  uint32_t sig_id = 0;
+  uint32_t row = 0;
+  SemanticKind kind = SemanticKind::Arbitrary;
+  int32_t data_index = -1; // OutputMeshData index, -1 for builtins only
+  std::string user;
+  air::MSLScalerOrVectorType type = air::msl_float4;
+  uint32_t start_col = 0;
+  uint32_t cols = 0;
+  uint32_t clip_base = 0; // ClipDistance: index of this row's first scalar
+};
+
+struct MeshOutputLayout {
+  std::vector<MeshOutputRow> vertex;
+  std::vector<MeshOutputRow> primitive;
+  uint32_t clip_count = 0;
+
+  const MeshOutputRow *
+  find(bool primitive_output, uint32_t sig_id, uint32_t row) const {
+    for (auto &r : primitive_output ? primitive : vertex)
+      if (r.sig_id == sig_id && r.row == row)
+        return &r;
+    return nullptr;
+  }
+};
+
+llvm::Expected<MeshOutputLayout> build_mesh_output_layout(const EntryPoint &entry);
+
+const MeshState *find_mesh_state(const EntryPoint &entry);
+const AmplificationState *find_amplification_state(const EntryPoint &entry);
+
+} // namespace dxmt::dxil
diff --git a/src/airconv/dxil_metadata.cpp b/src/airconv/dxil_metadata.cpp
