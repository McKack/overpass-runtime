+
+llvm::Error
+IOHelper::InitializePerVertexInput(
+    uint32_t with_interpolant_at, uint32_t with_barycentric_at, uint32_t to_reg, uint32_t mask,
+    uint32_t first_vertex_reg
+) {
+  /* Metal before Apple10 GPUs has no per-vertex fragment inputs. The value interpolated without perspective, L,
+     and the barycentric weights b (also without perspective) are both affine in screen space, so with their
+     screen derivatives they give three equations for the three vertex values a:
+       b . a = L,   ddx(b) . a = ddx(L),   ddy(b) . a = ddy(L)
+     Solved with the inverse through cross products: rows R0 = b, R1 = ddx(b), R2 = ddy(b); columns of the
+     adjugate C0 = R1 x R2, C1 = R2 x R0, C2 = R0 x R1; a_k = (C0[k] L + C1[k] ddx(L) + C2[k] ddy(L)) / det. */
+  auto L = air.CreateInterpolateAtCenter(function->getArg(with_interpolant_at), false);
+  auto Lx = air.CreateDerivative(L, false), Ly = air.CreateDerivative(L, true);
+  llvm::Value *b = function->getArg(with_barycentric_at);
+  llvm::Value *rows[3] = {b, air.CreateDerivative(b, false), air.CreateDerivative(b, true)};
+  auto element = [&](llvm::Value *v, unsigned i) { return ir.CreateExtractElement(v, i); };
+  auto cross = [&](llvm::Value *u, llvm::Value *v, unsigned k) {
+    unsigned i = (k + 1) % 3, j = (k + 2) % 3;
+    return ir.CreateFSub(ir.CreateFMul(element(u, i), element(v, j)), ir.CreateFMul(element(u, j), element(v, i)));
+  };
+  llvm::Value *det = nullptr;
+  for (unsigned k = 0; k < 3; k++) {
+    auto term = ir.CreateFMul(element(rows[0], k), cross(rows[1], rows[2], k));
+    det = det ? ir.CreateFAdd(det, term) : term;
+  }
+  auto rcp_det = ir.CreateFDiv(air.getFloat(1.0f), det);
+  auto splat = [&](llvm::Value *s) { return ir.CreateVectorSplat(4, s); };
+  for (uint32_t vertex = 0; vertex < 3; vertex++) {
+    auto value = ir.CreateFAdd(
+        ir.CreateFAdd(
+            ir.CreateFMul(splat(cross(rows[1], rows[2], vertex)), L), ir.CreateFMul(splat(cross(rows[2], rows[0], vertex)), Lx)
+        ),
+        ir.CreateFMul(splat(cross(rows[0], rows[1], vertex)), Ly)
+    );
+    value = ir.CreateFMul(value, splat(rcp_det));
+    if (auto err = InitializeInputValue(value, first_vertex_reg + vertex, mask, false))
+      return err;
+    /* The register itself holds the first (provoking) vertex's value, like flat interpolation. */
+    if (vertex == 0)
+      if (auto err = InitializeInputValue(value, to_reg, mask, false))
+        return err;
+  }
+  return llvm::Error::success();
+}
